{
  "schema": "CrankCardScenarios@1",
  "card": "Coalition Relic",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    }
  },
  "scenarios": [
    {
      "name": "A charge counter on turn 1; at Rob's next first main phase it is removed for one mana of the color he names",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Coalition Relic"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "activate": "Coalition Relic"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "counters": {
                "card": "Coalition Relic",
                "counter": "charge",
                "count": 1
              }
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "White",
                  "Blue",
                  "Black",
                  "Red",
                  "Green"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Green"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 1
          }
        },
        {
          "seat": 0,
          "counters": {
            "card": "Coalition Relic",
            "counter": "charge",
            "count": 0
          }
        }
      ]
    },
    {
      "name": "{T}: one mana of any color, its color chosen as it is tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Coalition Relic"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Coalition Relic",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        },
        {
          "seat": 0,
          "tapped": "Coalition Relic",
          "is": true
        }
      ]
    },
    {
      "name": "With no charge counter, the trigger adds nothing and asks nothing",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Coalition Relic"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "stack": 0
        },
        {
          "seat": 0,
          "pool": {
            "W": 0,
            "U": 0,
            "B": 0,
            "R": 0,
            "G": 0
          }
        }
      ]
    }
  ]
}
