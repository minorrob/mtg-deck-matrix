{
  "name": "crankmagic-staging",
  "main": "cloud/play-worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "staging.crankmagic.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crankmagic-staging",
      "database_id": "b7f806ec-c9e8-4265-9f23-7d9705db9a26",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "vars": {
    "SHARING_ENABLED": "on",
    "INVITE_ADMIN_ID": "1",
    "CLOUDFLARE_ACCOUNT_ID": "02e7ae6d703281008f546c63378c6ddb",
    "ACCESS_INVITE_APP_IDS": "16fef6e1-0437-4bbd-b7fe-a81419dc09fa,23915d70-d40d-4f6f-9170-d43b3bf412d8",
    "ACCESS_INVITE_POLICY_ID": "8b802602-b991-4986-b8a1-d2c16b3cf5c3,c59874d0-8ba7-4e99-ab80-2e11de62cfa8",
    "INVITE_LINK_ORIGIN": "https://crankmagic.com",
    "ACCESS_TEAM_DOMAIN": "crankmagic.cloudflareaccess.com",
    "ACCESS_AUD": "213cb6b10352e5ed5525d6337f355cd5190dec402e86debd30971d3bd5bda1f5",
    "PLAYTEST_TABLES": "on",
    "SERVICE_SEATS": "on",
    "AI_ACCESS_AUD": "d3e7b5812c81536cb707c64cca2196e1ee7854cbca6791f4d7bd2ef4b649f6db",
    "AI_CAP_TOTAL_CENTS": "300",
    "AI_CAP_PERSON_CENTS": "300",
    "AI_MODEL": "claude-haiku-5-5",
    "AI_COACH": "on",
    "AI_CAP_COACH_CENTS": "150",
    "AI_PILOT": "on",
    "AI_CAP_PILOT_GAME_CENTS": "25",
    "AI_ADVISE": "on",
    "AI_EVERYONE": "on"
  },
  "ratelimits": [
    {
      "name": "LIMIT_IP",
      "namespace_id": "2001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "LIMIT_PERSON",
      "namespace_id": "2002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLES",
        "class_name": "GameTable"
      }
    ]
  },
  "migrations": [
    {
      "tag": "tables-v1",
      "new_sqlite_classes": [
        "GameTable"
      ]
    }
  ]
}
