{
  "schema": "CrankCardScenarios@1",
  "card": "Weathered Wayfarer",
  "scenarios": [
    {
      "name": "Maya has three lands to his one: he searches out a land card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Weathered Wayfarer",
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "library",
          "cards": [
            "Forest"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains"
        },
        {
          "activate": "Weathered Wayfarer"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Forest"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "One land each: not offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Weathered Wayfarer",
            "Plains"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Weathered Wayfarer"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": []
    }
  ]
}
