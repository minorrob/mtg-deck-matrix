{
  "schema": "CrankCardScenarios@1",
  "card": "Wall of Omens",
  "scenarios": [
    {
      "name": "It enters, its trigger goes on the stack, and it draws a card",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wall of Omens"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Plains",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Wall of Omens"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "battlefield",
              "cards": [
                "Plains",
                "Wall of Omens",
                "Wastes"
              ]
            },
            {
              "stack": 1
            },
            {
              "seat": 0,
              "zone": "hand",
              "cards": []
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wastes"
          ]
        },
        {
          "stack": 0
        }
      ]
    }
  ]
}
