{
  "schema": "CrankCardScenarios@1",
  "card": "Whirlwind of Thought",
  "fixtures": {
    "Relic Fixture": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{C}"
    },
    "Bear Fixture": {
      "types": [
        "Creature"
      ],
      "manaCost": "{C}",
      "power": 1,
      "toughness": 1
    }
  },
  "scenarios": [
    {
      "name": "Casting Relic Fixture triggers it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Whirlwind of Thought",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Relic Fixture"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "cast": "Relic Fixture"
        },
        {
          "expect": [
            {
              "stack": 2
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        }
      ]
    },
    {
      "name": "Bear Fixture does not",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Whirlwind of Thought",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear Fixture"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "cast": "Bear Fixture"
        }
      ],
      "expect": [
        {
          "stack": 1
        }
      ]
    }
  ]
