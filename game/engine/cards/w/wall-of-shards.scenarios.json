              "asks": {
                "seat": 0,
                "options": [
                  "Have an opponent gain 1 life",
                  "Don't pay"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Have an opponent gain 1 life"
          ]
        },
        {
          "expect": [
            {
              "seat": 1,
              "life": 41
            },
            {
              "seat": 0,
              "counters": {
                "card": "Wall of Shards",
                "counter": "age",
                "count": 1
              }
            }
          ]
        },
        {
          "to": {
            "turn": 5,
            "phase": "UPKEEP"
          }
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Have an opponent gain 1 life, 2 times"
          ]
        }
      ],
      "expect": [
        {
          "seat": 1,
          "life": 43
        },
        {
          "seat": 0,
          "life": 40
        },
        {
          "seat": 0,
          "counters": {
            "card": "Wall of Shards",
            "counter": "age",
            "count": 2
          }
        },
        {
          "seat": 0,
