{
  "schema": "CrankCardScenarios@1",
  "card": "Wall of Shards",
  "scenarios": [
    {
      "name": "Rob's upkeep: an age counter, and Maya gains 1 life to keep it; next time two counters, and 2 life",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wall of Shards"
          ],
          "sick": true
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 3,
            "phase": "UPKEEP"
          }
        },
        {
          "resolve": true
        },
        {
          "expect": [
