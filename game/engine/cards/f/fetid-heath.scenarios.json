{
  "schema": "CrankCardScenarios@1",
  "card": "Fetid Heath",
  "scenarios": [
    {
      "name": "{W} from a Plains filtered into {B}{B}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Fetid Heath",
            "Plains"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains"
        },
        {
          "tap": "Fetid Heath",
          "mana": {
            "B": 2
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 2
          }
        }
      ]
    },
    {
      "name": "or into {W}{B}; alone, it adds {C}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Fetid Heath",
            "Swamp",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp"
        },
        {
          "tap": "Fetid Heath",
          "mana": {
            "W": 1,
            "B": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "W": 1,
            "B": 1
          }
        }
      ]
    }
  ]
}
