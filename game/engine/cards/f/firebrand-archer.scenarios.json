{
  "schema": "CrankCardScenarios@1",
  "card": "Firebrand Archer",
  "fixtures": {
    "Charm Fixture": {
      "types": [
        "Enchantment"
      ],
      "manaCost": "{C}"
    },
    "Bear Fixture": {
      "types": [
        "Creature"
      ],
      "manaCost": "{C}",
      "power": 1,
      "toughness": 1
    }
  },
  "scenarios": [
    {
      "name": "Casting Charm Fixture triggers it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Firebrand Archer",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Charm Fixture"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Charm Fixture"
        },
        {
          "expect": [
            {
              "stack": 2
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 1,
          "life": 39
        }
      ]
    },
    {
      "name": "Bear Fixture does not",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Firebrand Archer",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear Fixture"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Bear Fixture"
        }
      ],
      "expect": [
        {
          "stack": 1
        }
      ]
    }
  ]
}
