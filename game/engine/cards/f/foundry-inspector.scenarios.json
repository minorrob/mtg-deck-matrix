{
  "schema": "CrankCardScenarios@1",
  "card": "Foundry Inspector",
  "fixtures": {
    "Relic Two": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{2}"
    },
    "Charm Two": {
      "types": [
        "Enchantment"
      ],
      "manaCost": "{2}"
    }
  },
  "scenarios": [
    {
      "name": "Relic Two costs one less: one land pays for it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Foundry Inspector",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Relic Two"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Relic Two"
              },
              "count": 1
            }
          ]
        },
        {
          "cast": "Relic Two"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "stack": 0
        }
      ]
    },
    {
      "name": "Charm Two does not: one land is not enough",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Foundry Inspector",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Charm Two"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "cast",
            "card": "Charm Two"
          },
          "count": 0
        }
      ]
    }
  ]
}
