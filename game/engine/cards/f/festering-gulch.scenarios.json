{
  "schema": "CrankCardScenarios@1",
  "card": "Festering Gulch",
  "scenarios": [
    {
      "name": "Played, it enters tapped and deals 1 to Maya; next turn it taps for {B} or {G}",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Festering Gulch"
          ]
        }
      ],
      "steps": [
        {
          "play": "Festering Gulch"
        },
        {
          "settle": true
        },
        {
          "expect": [
            {
              "seat": 1,
              "life": 39
            },
            {
              "seat": 0,
              "tapped": "Festering Gulch"
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Festering Gulch"
              },
              "count": 2
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Festering Gulch",
          "is": false
        }
      ]
    },
    {
      "name": "Three players: Rob chooses which opponent it damages",
      "seats": 3,
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Festering Gulch"
          ]
        }
      ],
      "steps": [
        {
          "play": "Festering Gulch"
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Maya",
                  "Trey"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Trey"
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 2,
          "life": 39
        },
        {
          "seat": 1,
          "life": 40
        },
        {
          "seat": 0,
          "life": 40
        }
      ]
    }
  ]
}
