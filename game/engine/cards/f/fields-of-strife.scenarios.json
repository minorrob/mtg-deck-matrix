{
  "schema": "CrankCardScenarios@1",
  "card": "Fields of Strife",
  "scenarios": [
    {
      "name": "Played, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Fields of Strife"
          ]
        }
      ],
      "steps": [
        {
          "play": "Fields of Strife"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Fields of Strife"
        }
      ]
    },
    {
      "name": "{T}: {W}; and {2}{R}{W}, {T}: surveil 1",
      "library": [
        "Island"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Fields of Strife",
            "Mountain",
            "Plains",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Mountain",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Fields of Strife",
          "ability": "a2"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Island"
                ]
              }
            }
          ]
        },
        {
          "answer": [
            0
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "tapped": "Fields of Strife"
        }
      ]
    }
  ]
}
