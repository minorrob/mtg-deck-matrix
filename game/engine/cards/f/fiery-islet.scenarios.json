{
  "schema": "CrankCardScenarios@1",
  "card": "Fiery Islet",
  "scenarios": [
    {
      "name": "{U} or {R} for 1 life",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Fiery Islet"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Fiery Islet"
              },
              "count": 2,
              "mana": [
                {
                  "R": 1
                },
                {
                  "U": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Fiery Islet",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        },
        {
          "seat": 0,
          "life": 39
        }
      ]
    },
    {
      "name": "{1}, sacrifice: a card",
      "library": [
        "Wastes"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Fiery Islet",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "activate": "Fiery Islet"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Fiery Islet"
          ]
        }
      ]
    }
  ]
}
