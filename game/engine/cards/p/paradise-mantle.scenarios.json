{
  "schema": "CrankCardScenarios@1",
  "card": "Paradise Mantle",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    }
  },
  "scenarios": [
    {
      "name": "Equipped, the Bear taps for any color; the Ogre beside it does not",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Paradise Mantle",
            "Bear",
            "Ogre",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Bear"
              },
              "count": 0
            }
          ]
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Paradise Mantle",
          "targets": [
            {
              "card": "Bear"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Bear"
          },
          "count": 5
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Ogre"
          },
          "count": 0
        }
      ]
    }
  ]
}
