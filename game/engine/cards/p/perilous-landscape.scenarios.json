      "library": [
        "Forest",
        "Island"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Perilous Landscape"
          ]
        }
      ],
      "steps": [
        {
          "activate": "Perilous Landscape",
          "ability": "a1"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Island"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Island"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Perilous Landscape"
          ]
