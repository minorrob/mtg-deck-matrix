        {
          "seat": 0,
          "controls": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "tapped": "Island"
        }
      ]
    },
    {
      "name": "Cycled for {U}{R}{W}: a card drawn",
      "library": [
        "Forest"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Mountain",
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Perilous Landscape"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Mountain"
        },
        {
          "tap": "Plains"
        },
        {
          "activate": "Perilous Landscape",
          "ability": "a2"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Perilous Landscape"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ]
    }
