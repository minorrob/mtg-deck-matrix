  "scenarios": [
    {
      "name": "Not prepared at the beginning of Rob's upkeep: it becomes prepared; Omit Variables for {U/B} mills three",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Paradox Shaper // Omit Variables"
          ],
          "sick": true
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "UPKEEP"
          }
        },
        {
          "expect": [
            {
              "stack": 0
            },
            {
              "seat": 0,
              "zone": "exile",
              "cards": []
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "UPKEEP"
          }
        },
        {
          "expect": [
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "exile",
              "cards": [
                "Omit Variables"
              ]
            },
            {
              "event": "GameEventCardAttribute",
              "where": {
                "attribute": "prepared",
                "value": true
              }
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Island"
        },
        {
          "cast": "Omit Variables"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "count": 3
        },
        {
          "seat": 0,
          "zone": "exile",
          "cards": []
        },
        {
          "event": "GameEventCardAttribute",
          "where": {
            "attribute": "prepared",
            "value": false
          }
        },
        {
          "seat": 0,
          "stats": {
            "card": "Paradox Shaper",
            "power": 1,
            "toughness": 3
          }
        }
      ]
    },
