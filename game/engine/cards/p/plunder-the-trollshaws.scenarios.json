{
  "schema": "CrankCardScenarios@1",
  "card": "Plunder the Trollshaws",
  "scenarios": [
    {
      "name": "From the hand, one card; flashed back from the graveyard, two -- and the card exiled",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Wastes",
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Plunder the Trollshaws"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Plunder the Trollshaws"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "hand",
              "count": 1
            },
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Plunder the Trollshaws"
              ]
            }
          ]
        },
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Plunder the Trollshaws"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 3
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": []
        },
        {
          "seat": 0,
          "zone": "exile",
          "cards": [
            "Plunder the Trollshaws"
          ]
        }
      ]
    },
    {
      "name": "From the graveyard only for {3}{U}: its mana cost is not enough",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Plunder the Trollshaws"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "cast",
            "card": "Plunder the Trollshaws"
          },
          "count": 0
        }
      ]
    }
  ]
}
