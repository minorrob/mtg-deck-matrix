        {
          "tap": "Island"
        },
        {
          "cast": "Preordain"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Mountain",
                  "Forest"
                ],
                "min": 0
              }
            }
          ]
        },
        {
          "answer": [
            0
          ]
