{
  "schema": "CrankCardScenarios@1",
  "card": "Preordain",
  "scenarios": [
    {
      "name": "Scry 2, then a card",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Preordain"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "cast": "Preordain"
        },
        {
          "resolve": true
        },
        {
          "answer": [
            1
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        }
      ]
