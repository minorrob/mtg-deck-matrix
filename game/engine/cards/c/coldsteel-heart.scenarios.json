{
  "schema": "CrankCardScenarios@1",
  "card": "Coldsteel Heart",
  "scenarios": [
    {
      "name": "Tap replacement chosen first, then blue; enters tapped and next turn produces only {U}",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Coldsteel Heart"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Coldsteel Heart"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Effect: This artifact enters tapped.",
                  "Effect: As this artifact enters, choose a color."
                ]
              }
            },
            {
              "seat": 0,
              "zone": "battlefield",
              "cards": [
                "Wastes",
                "Wastes"
              ]
            }
          ]
        },
        {
          "choose": [
            "Effect: This artifact enters tapped."
          ]
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "White",
                  "Blue",
                  "Black",
                  "Red",
                  "Green"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Blue"
          ]
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Coldsteel Heart",
              "is": true
            },
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Coldsteel Heart"
              },
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Coldsteel Heart"
              },
              "count": 1,
              "mana": [
                {
                  "U": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Coldsteel Heart"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "U": 1
          }
        }
      ]
    },
    {
      "name": "Color replacement chosen first, then red; enters tapped and next turn produces only {R}",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Coldsteel Heart"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Coldsteel Heart"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Effect: This artifact enters tapped.",
                  "Effect: As this artifact enters, choose a color."
                ]
              }
            },
            {
              "seat": 0,
              "zone": "battlefield",
              "cards": [
                "Wastes",
                "Wastes"
              ]
            }
          ]
        },
        {
          "choose": [
            "Effect: As this artifact enters, choose a color."
          ]
        },
        {
          "choose": [
            "Red"
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Coldsteel Heart"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1,
            "U": 0
          }
        }
      ]
    }
  ]
}
