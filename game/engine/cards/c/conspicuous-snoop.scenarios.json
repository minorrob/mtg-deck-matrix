{
  "schema": "CrankCardScenarios@1",
  "card": "Conspicuous Snoop",
  "fixtures": {
    "Goblin Scout": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Goblin"
      ],
      "manaCost": "{R}",
      "colors": [
        "R"
      ],
      "power": 1,
      "toughness": 1
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "An explicit conditional top Goblin cast pays and resolves",
      "library": ["Raging Goblin"],
      "setup": [{"seat": 0, "zone": "battlefield", "cards": ["Conspicuous Snoop", "Mountain"]}],
      "steps": [
        {"tap": "Mountain", "source": {"zone": "battlefield", "index": 0}},
        {"actIfLegal": {"cast": "Raging Goblin", "seat": 0, "source": {"zone": "library", "index": 0}, "targets": []}, "resolveSelected": true}
      ],
      "expect": [
        {"seat": 0, "zone": "battlefield", "cards": ["Conspicuous Snoop", "Mountain", "Raging Goblin"]},
        {"seat": 0, "pool": {"R": 0}},
        {"stack": 0}
      ]
    },
    {
      "name": "An explicit conditional inherited Krenko activation resolves two Goblins",
      "library": ["Krenko, Mob Boss"],
      "setup": [{"seat": 0, "zone": "battlefield", "cards": ["Conspicuous Snoop", "Fanatical Firebrand"]}],
      "steps": [
        {"actIfLegal": {"activate": "Conspicuous Snoop", "seat": 0, "source": {"zone": "battlefield", "index": 0}, "targets": []}, "resolveSelected": true}
      ],
      "expect": [
        {"seat": 0, "zone": "battlefield", "cards": ["Conspicuous Snoop", "Fanatical Firebrand", "Goblin", "Goblin"]},
        {"seat": 0, "tapped": "Conspicuous Snoop"},
        {"stack": 0}
      ]
    },
    {
      "name": "The non-Goblin top is public to both players while another library stays hidden",
      "library": ["Bear"],
      "setup": [{"seat": 0, "zone": "battlefield", "cards": ["Conspicuous Snoop"]}],
      "steps": [],
      "expect": [
        {"seat": 0, "zone": "library", "cards": ["Bear"]},
        {"seat": 1, "of": 0, "zone": "library", "cards": ["Bear"]},
        {"seat": 0, "of": 1, "zone": "library", "cards": []},
        {"seat": 1, "zone": "library", "cards": []}
      ]
    },
    {
      "name": "A Goblin cast from the top of the library",
      "library": [
        "Goblin Scout"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Mountain"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Mountain"
        },
        {
          "cast": "Goblin Scout"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Mountain",
            "Goblin Scout"
          ]
        }
      ]
    },
    {
      "name": "A card that is not a Goblin is not cast from there, and gives nothing",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Forest",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "cast",
            "card": "Bear"
          },
          "count": 0
        },
        {
          "offers": {
            "kind": "activate",
            "card": "Conspicuous Snoop"
          },
          "count": 0
        }
      ]
    },
    {
      "name": "With Krenko on top, the Snoop has Krenko's ability: a Goblin for each Goblin it controls",
      "library": [
        "Krenko, Mob Boss"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Goblin Scout"
          ]
        }
      ],
      "steps": [
        {
          "activate": "Conspicuous Snoop"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Goblin Scout",
            "Goblin",
            "Goblin"
          ]
        },
        {
          "seat": 0,
          "tapped": "Conspicuous Snoop"
        }
      ]
    },
    {
      "name": "With Skirk Prospector on top, the Snoop has its mana ability: sacrifice a Goblin, add {R}",
      "library": [
        "Skirk Prospector"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Conspicuous Snoop",
            "Goblin Scout"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Conspicuous Snoop",
          "sacrifice": "Goblin Scout"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Goblin Scout"
          ]
        }
      ]
    }
  ]
}
