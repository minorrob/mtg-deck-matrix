{
  "schema": "CrankCardScenarios@1",
  "card": "Clifftop Retreat",
  "scenarios": [
    {
      "name": "With a Plains out, it enters untapped and taps for either",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Clifftop Retreat"
          ]
        }
      ],
      "steps": [
        {
          "play": "Clifftop Retreat"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Clifftop Retreat",
          "is": false
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Clifftop Retreat"
          },
          "count": 2,
          "mana": [
            {
              "R": 1
            },
            {
              "W": 1
            }
          ]
        }
      ]
    },
    {
      "name": "Without a Mountain or a Plains, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Clifftop Retreat"
          ]
        }
      ],
      "steps": [
        {
          "play": "Clifftop Retreat"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Clifftop Retreat"
        }
      ]
    },
    {
      "name": "An opponent's Mountain does not count: \"you control\"",
      "setup": [
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Mountain"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Clifftop Retreat"
          ]
        }
      ],
      "steps": [
        {
          "play": "Clifftop Retreat"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Clifftop Retreat"
        }
      ]
    }
  ]
}
