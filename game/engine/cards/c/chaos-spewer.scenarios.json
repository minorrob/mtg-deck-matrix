{
  "schema": "CrankCardScenarios@1",
  "card": "Chaos Spewer",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Rob pays {2}: no -1/-1 counters, a 5/4",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Chaos Spewer"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Swamp",
            "Wastes",
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Chaos Spewer"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Pay {2}",
                  "Don't pay"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Pay {2}"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "stats": {
            "card": "Chaos Spewer",
            "power": 5,
            "toughness": 4
          }
        },
        {
          "seat": 0,
          "counters": {
            "card": "Chaos Spewer",
            "counter": "-1/-1",
            "count": 0
          }
        },
        {
          "seat": 0,
          "tapped": "Wastes"
        }
      ]
    },
    {
      "name": "Rob doesn't pay: blight 2 on his Bear, which dies; the Spewer stays a 5/4",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Chaos Spewer"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mountain",
            "Wastes",
            "Wastes",
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Mountain"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Chaos Spewer"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Don't pay"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Don't pay"
          ]
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Bear",
                  "Chaos Spewer"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Bear"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 0,
          "stats": {
            "card": "Chaos Spewer",
            "power": 5,
            "toughness": 4
          }
        }
      ]
    },
    {
      "name": "Rob doesn't pay: blight 2 on the Spewer itself, a 3/2",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Chaos Spewer"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Swamp",
            "Wastes",
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Chaos Spewer"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Don't pay"
          ]
        },
        {
          "choose": [
            "Chaos Spewer"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "counters": {
            "card": "Chaos Spewer",
            "counter": "-1/-1",
            "count": 2
          }
        },
        {
          "seat": 0,
          "stats": {
            "card": "Chaos Spewer",
            "power": 3,
            "toughness": 2
          }
        }
      ]
    }
  ]
}
