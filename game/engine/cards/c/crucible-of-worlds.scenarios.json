{
  "schema": "CrankCardScenarios@1",
  "card": "Crucible of Worlds",
  "scenarios": [
    {
      "name": "A land from the graveyard, as the land drop",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Crucible of Worlds"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 1
            }
          ]
        },
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": []
        }
      ]
    }
  ]
}
