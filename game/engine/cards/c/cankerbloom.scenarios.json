{
  "schema": "CrankCardScenarios@1",
  "card": "Cankerbloom",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Charm Ward": {
      "types": [
        "Enchantment"
      ],
      "manaCost": "{1}{W}",
      "colors": [
        "W"
      ]
    },
    "Walker": {
      "types": [
        "Planeswalker"
      ],
      "subtypes": [
        "Ajani"
      ],
      "manaCost": "{2}{W}",
      "colors": [
        "W"
      ],
      "loyalty": 4
    }
  },
  "scenarios": [
    {
      "name": "{1}, sacrificed: Maya's Rock destroyed",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Cankerbloom",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Rock",
            "Charm Ward"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "activate": "Cankerbloom",
          "modes": [
            0
          ],
          "targets": [
            {
              "card": "Rock"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Rock"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Cankerbloom"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Charm Ward"
          ]
        }
      ]
    },
    {
      "name": "{1}, sacrificed: Maya's Charm Ward destroyed -- the artifact mode cannot aim at it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Cankerbloom",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Charm Ward"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Cankerbloom"
              },
              "count": 2
            }
          ]
        },
        {
          "activate": "Cankerbloom",
          "modes": [
            1
          ],
          "targets": [
            {
              "card": "Charm Ward"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Charm Ward"
          ]
        }
      ]
    },
    {
      "name": "{1}, sacrificed: proliferate -- Rob's Walker from 4 loyalty to 5",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Cankerbloom",
            "Wastes",
            "Walker"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "activate": "Cankerbloom",
          "modes": [
            2
          ]
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Walker (4 loyalty)"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "counters": {
            "card": "Walker",
            "counter": "loyalty",
            "count": 5
          }
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Cankerbloom"
          ]
        }
      ]
