{
  "schema": "CrankCardScenarios@1",
  "card": "Riveteers Overlook",
  "scenarios": [
    {
      "name": "It enters and is sacrificed; when he does, a basic Mountain onto the battlefield tapped, and 1 life",
      "library": [
        "Plains",
        "Mountain"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Riveteers Overlook"
          ]
        }
      ],
      "steps": [
        {
          "play": "Riveteers Overlook"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Riveteers Overlook"
              ]
            },
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Mountain"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Mountain"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mountain"
          ]
        },
        {
          "seat": 0,
          "tapped": "Mountain",
          "is": true
        },
        {
          "seat": 0,
          "life": 41
        },
        {
          "stack": 0
        }
      ]
    }
  ]
}
