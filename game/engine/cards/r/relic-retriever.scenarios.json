{
  "schema": "CrankCardScenarios@1",
  "card": "Relic Retriever",
  "fixtures": {
    "Spark": {
      "types": [
        "Instant"
      ],
      "manaCost": "{R}",
      "colors": [
        "R"
      ]
    }
  },
  "scenarios": [
    {
      "name": "A card returned from the graveyard this turn: a Treasure at the end step",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Relic Retriever",
            "Forest",
            "Forest",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Eternal Witness"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Spark"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Eternal Witness"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Spark"
          ]
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Yes"
          ]
        },
        {
          "to": {
            "turn": 1,
            "phase": "END_OF_TURN"
          }
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Relic Retriever",
            "Forest",
            "Forest",
            "Wastes",
            "Eternal Witness",
            "Treasure"
          ]
        }
      ]
    },
    {
      "name": "Nothing left the graveyard: no Treasure, at either end step",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Relic Retriever"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Spark"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 1,
            "phase": "END_OF_TURN"
          }
        },
        {
          "expect": [
            {
              "stack": 0
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "END_OF_TURN"
          }
        },
        {
          "expect": [
            {
              "stack": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Relic Retriever"
          ]
        }
      ]
    },
    {
      "name": "Each end step: a card Maya's Ooze exiles from Rob's graveyard on her turn makes Rob a Treasure at hers",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Relic Retriever"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Spark"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Scavenging Ooze",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Forest",
          "seat": 1
        },
        {
          "activate": "Scavenging Ooze",
          "seat": 1,
          "targets": [
            {
              "card": "Spark"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 2,
            "phase": "END_OF_TURN"
          }
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Relic Retriever",
            "Treasure"
          ]
        },
        {
          "seat": 1,
          "controls": [
            "Scavenging Ooze",
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "A card leaving Maya's graveyard is not one leaving Rob's: no Treasure",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Relic Retriever"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Spark"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Scavenging Ooze",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Forest",
          "seat": 1
        },
        {
          "activate": "Scavenging Ooze",
          "seat": 1,
          "targets": [
            {
              "card": "Spark"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 2,
            "phase": "END_OF_TURN"
          }
        },
        {
          "expect": [
            {
              "stack": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Relic Retriever"
          ]
        }
      ]
    }
  ]
}
