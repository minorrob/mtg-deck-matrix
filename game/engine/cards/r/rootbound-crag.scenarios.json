{
  "schema": "CrankCardScenarios@1",
  "card": "Rootbound Crag",
  "scenarios": [
    {
      "name": "With a Forest it enters untapped; without, tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Forest"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Rootbound Crag"
          ]
        }
      ],
      "steps": [
        {
          "play": "Rootbound Crag"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Rootbound Crag",
          "is": false
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Rootbound Crag"
          },
          "count": 2,
          "mana": [
            {
              "R": 1
            },
            {
              "G": 1
            }
          ]
        }
      ]
    },
    {
      "name": "Without one, tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Rootbound Crag"
          ]
        }
      ],
      "steps": [
        {
          "play": "Rootbound Crag"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Rootbound Crag"
        }
      ]
    }
  ]
}
