{
  "schema": "CrankCardScenarios@1",
  "card": "Argivian Restoration",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Other Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "The Rock in Rob's graveyard returns onto the battlefield; the Bear there and Maya's Other Rock are no targets",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Argivian Restoration"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Rock",
            "Bear"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Other Rock"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Argivian Restoration"
              },
              "count": 1,
              "targets": [
                [
                  "Rock"
                ]
              ]
            }
          ]
        },
        {
          "cast": "Argivian Restoration",
          "targets": [
            {
              "card": "Rock"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Island",
            "Island",
            "Rock",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear",
            "Argivian Restoration"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Other Rock"
          ]
        }
      ]
    },
    {
      "name": "No artifact card in Rob's graveyard (only a creature card, and one in Maya's): it cannot be cast",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Island",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Argivian Restoration"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Other Rock"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Argivian Restoration"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        }
      ]
    }
  ]
}
