{
  "schema": "CrankCardScenarios@1",
  "card": "Arbor Elf",
  "scenarios": [
    {
      "name": "Forest tapped for {G}, then untapped: {G}{G}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Arbor Elf",
            "Forest",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "activate": "Arbor Elf",
          "targets": [
            {
              "card": "Forest"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "tap": "Forest"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 2
          }
        }
      ]
    },
    {
      "name": "An Island is not a Forest",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Arbor Elf",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Arbor Elf"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": []
    }
  ]
}
