{
  "schema": "CrankCardScenarios@1",
  "card": "Azorius Signet",
  "scenarios": [
    {
      "name": "{1} and {T} for two colors: offered only once the {1} is in the pool",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Azorius Signet",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Azorius Signet"
              },
              "count": 0
            }
          ]
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Azorius Signet"
              },
              "count": 1,
              "mana": [
                {
                  "W": 1,
                  "U": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Azorius Signet"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "W": 1,
            "U": 1,
            "C": 0
          }
        },
        {
          "stack": 0
        },
        {
          "seat": 0,
          "tapped": "Azorius Signet"
        }
      ]
    }
  ]
}
