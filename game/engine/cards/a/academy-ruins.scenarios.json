{
  "schema": "CrankCardScenarios@1",
  "card": "Academy Ruins",
  "fixtures": {
    "Relic": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "An artifact card from Rob's graveyard on top of his library, and drawn next",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Academy Ruins",
            "Island",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Relic",
            "Bear"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Relic"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Academy Ruins"
              },
              "count": 0
            }
          ]
        },
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Academy Ruins"
              },
              "count": 1,
              "targets": [
                [
                  "Relic"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Academy Ruins",
          "targets": [
            {
              "card": "Relic",
              "seat": 0
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Bear"
              ]
            },
            {
              "seat": 1,
              "zone": "graveyard",
              "cards": [
                "Relic"
              ]
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Relic"
          ]
        }
      ]
    },
    {
      "name": "It taps for {C}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Academy Ruins"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Academy Ruins"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 1
          }
        }
      ]
    }
  ]
}
