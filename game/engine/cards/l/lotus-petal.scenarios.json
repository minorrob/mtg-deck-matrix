{
  "schema": "CrankCardScenarios@1",
  "card": "Lotus Petal",
  "scenarios": [
    {
      "name": "Any color, once, and it is gone",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Lotus Petal"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Lotus Petal"
              },
              "count": 5
            }
          ]
        },
        {
          "tap": "Lotus Petal",
          "mana": {
            "G": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 1
          }
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Lotus Petal"
          ]
        },
        {
          "stack": 0
        }
      ]
    }
  ]
}
