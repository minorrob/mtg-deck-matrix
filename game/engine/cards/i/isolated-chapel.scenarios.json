{
  "schema": "CrankCardScenarios@1",
  "card": "Isolated Chapel",
  "scenarios": [
    {
      "name": "With a Swamp out, it enters untapped and taps for either",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Swamp"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Isolated Chapel"
          ]
        }
      ],
      "steps": [
        {
          "play": "Isolated Chapel"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Isolated Chapel",
          "is": false
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Isolated Chapel"
          },
          "count": 2,
          "mana": [
            {
              "W": 1
            },
            {
              "B": 1
            }
          ]
        }
      ]
    },
    {
      "name": "Without a Plains or a Swamp, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Isolated Chapel"
          ]
        }
      ],
      "steps": [
        {
          "play": "Isolated Chapel"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Isolated Chapel"
        }
      ]
    },
    {
      "name": "An opponent's Plains does not count: \"you control\"",
      "setup": [
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Isolated Chapel"
          ]
        }
      ],
      "steps": [
        {
          "play": "Isolated Chapel"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Isolated Chapel"
        }
      ]
    }
  ]
}
