      "name": "The Bear attacks alone: +1/+1 until end of turn, 3 to Maya",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ignoble Hierarch",
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Bear"
          ]
        },
        {
          "expect": [
            {
