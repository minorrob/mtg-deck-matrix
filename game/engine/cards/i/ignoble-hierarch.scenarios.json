        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ignoble Hierarch"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Ignoble Hierarch"
          ]
        },
        {
          "resolve": true
        }
