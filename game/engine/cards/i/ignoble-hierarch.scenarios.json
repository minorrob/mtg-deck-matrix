              "count": 3,
              "mana": [
                {
                  "B": 1
                },
                {
                  "R": 1
                },
                {
                  "G": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Ignoble Hierarch",
          "mana": {
            "R": 1
          }
