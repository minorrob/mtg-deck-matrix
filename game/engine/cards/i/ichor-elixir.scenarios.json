            {
              "seat": 0,
              "tapped": "Fractured Powerstone"
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Ichor Elixir",
