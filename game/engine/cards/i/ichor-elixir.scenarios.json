{
  "schema": "CrankCardScenarios@1",
  "card": "Ichor Elixir",
  "scenarios": [
    {
      "name": "{T}: Add {C}{C}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ichor Elixir"
          ]
        }
      ],
      "steps": [
