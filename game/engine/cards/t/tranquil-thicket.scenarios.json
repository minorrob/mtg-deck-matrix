{
  "schema": "CrankCardScenarios@1",
  "card": "Tranquil Thicket",
  "scenarios": [
    {
      "name": "Played, it enters tapped; on Rob's next turn it taps for {G}",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Tranquil Thicket"
          ]
        }
      ],
      "steps": [
        {
          "play": "Tranquil Thicket"
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Tranquil Thicket",
              "is": true
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Tranquil Thicket"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 1
          }
        }
      ]
    },
    {
      "name": "Cycling {G}: discarded from Rob's hand, and he draws a card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Forest"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Tranquil Thicket"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "activate": "Tranquil Thicket"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Tranquil Thicket"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "Without {G} it does not cycle",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Tranquil Thicket"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate",
            "card": "Tranquil Thicket"
          },
          "count": 0
        }
      ]
    }
  ]
}
