{
  "schema": "CrankCardScenarios@1",
  "card": "Tainted Peak",
  "scenarios": [
    {
      "name": "Without a Swamp: only {C} is offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tainted Peak"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Tainted Peak"
              },
              "count": 1,
              "mana": [
                {
                  "C": 1
                }
              ]
            }
          ]
        }
      ],
      "expect": []
    },
    {
      "name": "With a Swamp: the colors too (CR 602.5b)",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tainted Peak",
            "Swamp"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Tainted Peak"
              },
              "count": 3,
              "mana": [
                {
                  "C": 1
                },
                {
                  "B": 1
                },
                {
                  "R": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Tainted Peak",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        }
      ]
    }
  ]
}
