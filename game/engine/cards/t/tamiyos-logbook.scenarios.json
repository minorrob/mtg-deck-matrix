{
  "schema": "CrankCardScenarios@1",
  "card": "Tamiyo's Logbook",
  "fixtures": {
    "Smoke Relic": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Smoke Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Three other artifacts: {2}{U}, a card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tamiyo's Logbook",
            "Smoke Relic",
            "Smoke Relic",
            "Smoke Relic",
            "Island",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Tamiyo's Logbook"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "tapped": "Tamiyo's Logbook"
        }
      ]
    },
    {
      "name": "Five other artifacts: {U} alone -- the Logbook is not one of its own",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tamiyo's Logbook",
            "Smoke Relic",
            "Smoke Relic",
            "Smoke Relic",
            "Smoke Relic",
            "Smoke Relic",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "activate": "Tamiyo's Logbook"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        }
      ]
    },
    {
      "name": "None, and a Bear is no artifact: {2}{U} does not pay {5}{U}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tamiyo's Logbook",
            "Smoke Bear",
            "Island",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Tamiyo's Logbook"
              },
              "count": 0
            }
          ]
        }
