{
  "schema": "CrankCardScenarios@1",
  "card": "Tam, Observant Sequencer // Deep Sight",
  "scenarios": [
    {
      "name": "Landfall: Rob plays a Forest and Tam becomes prepared; Deep Sight for {G}{U}: a card and 1 life",
      "library": [
        "Swamp"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tam, Observant Sequencer // Deep Sight",
            "Island"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "play": "Forest"
        },
        {
          "expect": [
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "exile",
              "cards": [
                "Deep Sight"
              ]
            },
            {
              "event": "GameEventCardAttribute",
              "where": {
                "attribute": "prepared",
                "value": true
              }
            }
          ]
        },
        {
          "tap": "Forest"
        },
        {
          "tap": "Island"
        },
        {
          "cast": "Deep Sight"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Swamp"
          ]
        },
        {
          "seat": 0,
          "life": 41
        },
        {
          "seat": 0,
          "zone": "exile",
          "cards": []
        },
        {
          "event": "GameEventCardAttribute",
          "where": {
            "attribute": "prepared",
            "value": false
          }
        }
      ]
    },
    {
      "name": "A land Maya plays does not prepare Tam",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Tam, Observant Sequencer // Deep Sight"
          ]
        },
        {
          "seat": 1,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "play": "Forest",
          "seat": 1
        }
      ],
      "expect": [
        {
          "stack": 0
        },
        {
          "seat": 0,
          "zone": "exile",
          "cards": []
        },
        {
          "seat": 1,
          "controls": [
            "Forest"
          ]
        }
      ]
    }
  ]
}
