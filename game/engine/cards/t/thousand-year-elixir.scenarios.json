{
  "schema": "CrankCardScenarios@1",
  "card": "Thousand-Year Elixir",
  "scenarios": [
    {
      "name": "Llanowar Elves taps for mana the turn it arrives, then the Elixir untaps it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Thousand-Year Elixir"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Llanowar Elves"
          ],
          "sick": true
        }
      ],
      "steps": [
        {
          "tap": "Llanowar Elves"
        },
        {
          "expect": [
            {
              "seat": 0,
              "pool": {
                "G": 1
              }
            }
          ]
        },
        {
          "activate": "Thousand-Year Elixir",
          "targets": [
            {
              "card": "Llanowar Elves"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Llanowar Elves",
          "is": false
        },
        {
          "seat": 0,
          "tapped": "Thousand-Year Elixir"
        }
      ]
    },
    {
      "name": "Without it, a creature that has just arrived cannot tap: Krenko's ability waits",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Krenko, Mob Boss"
          ],
          "sick": true
        }
      ],
      "steps": [],
      "expect": [
        {
          "offers": {
            "kind": "activate",
            "card": "Krenko, Mob Boss"
          },
          "count": 0
        }
      ]
    },
    {
      "name": "With it, Krenko's {T} ability the turn it arrives: a Goblin",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Thousand-Year Elixir"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Krenko, Mob Boss"
          ],
          "sick": true
        }
      ],
      "steps": [
        {
          "activate": "Krenko, Mob Boss"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Thousand-Year Elixir",
            "Krenko, Mob Boss",
            "Goblin"
          ]
        }
      ]
    }
  ]
}
