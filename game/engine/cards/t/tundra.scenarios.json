{
  "schema": "CrankCardScenarios@1",
  "card": "Tundra",
  "scenarios": [
    {
      "name": "Untapped as it enters; {T}: {W} or {U}, either",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Tundra"
          ]
        }
      ],
      "steps": [
        {
          "play": "Tundra"
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Tundra",
              "is": false
            },
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Tundra"
              },
              "count": 2,
              "mana": [
                {
                  "W": 1
                },
                {
                  "U": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Tundra",
          "mana": {
            "U": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "U": 1,
            "W": 0
          }
        }
      ]
    }
  ]
}
