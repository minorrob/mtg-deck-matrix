  "scenarios": [
    {
      "name": "At Maya's draw step, after her draw: she puts her three cards on the bottom in the order she chooses, then draws three",
      "library": [
        "Mountain",
        "Island",
        "Plains",
        "Forest"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Teferi's Puzzle Box"
          ],
          "sick": true
        },
        {
          "seat": 1,
          "zone": "hand",
          "cards": [
            "Bear",
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "DRAW"
          }
        },
        {
          "expect": [
            {
              "stack": 1
            },
            {
              "seat": 1,
              "zone": "hand",
              "cards": [
                "Bear",
                "Ogre",
                "Mountain"
              ]
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 1,
                "options": [
                  "Bear",
                  "Ogre",
                  "Mountain"
                ],
                "min": 3
              }
            }
          ]
        },
        {
          "choose": [
            "Ogre",
            "Mountain",
            "Bear"
          ]
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "cards": [
            "Island",
            "Plains",
            "Forest"
          ]
        },
        {
          "seat": 1,
          "zone": "library",
          "count": 19
        },
        {
          "stack": 0
        }
      ]
    },
    {
      "name": "At his own draw step too: his Rock and the card he drew go under, and he draws two",
      "library": [
        "Mountain",
        "Island",
        "Plains",
        "Forest"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Teferi's Puzzle Box"
          ],
          "sick": true
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Rock"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "DRAW"
          }
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Mountain"
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "DRAW"
          }
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Rock",
                  "Mountain"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Rock",
            "Mountain"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Island",
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "library",
          "count": 19
        }
      ]
    },
    {
      "name": "Four players: it triggers at each player's draw step, each choosing their own order",
      "seats": 4,
      "library": [
        "Mountain",
        "Island"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Teferi's Puzzle Box"
          ],
          "sick": true
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "DRAW"
          }
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 1,
                "options": [
                  "Mountain"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Mountain"
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "DRAW"
          }
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 2
              }
            }
          ]
        },
        {
          "choose": [
            "Mountain"
          ]
        }
