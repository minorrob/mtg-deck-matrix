      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
