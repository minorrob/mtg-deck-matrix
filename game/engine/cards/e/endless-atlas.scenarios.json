{
  "schema": "CrankCardScenarios@1",
  "card": "Endless Atlas",
  "scenarios": [
    {
      "name": "Three Plains: {2}, {T}: draw a card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Endless Atlas",
            "Plains",
            "Plains",
            "Plains",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Endless Atlas"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "tapped": "Endless Atlas"
        }
      ]
    },
    {
      "name": "Two Plains and two Islands: not three with the same name, so not offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Endless Atlas",
            "Plains",
            "Plains",
            "Island",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate",
            "card": "Endless Atlas"
          },
          "count": 0
        }
      ]
    },
    {
      "name": "Maya's three Plains are not his",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Endless Atlas",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Plains",
            "Plains",
            "Plains"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate",
            "card": "Endless Atlas"
          },
          "count": 0
        }
      ]
    }
  ]
}
