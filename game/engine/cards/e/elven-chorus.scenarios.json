  "scenarios": [
    {
      "name": "Rob sees the Bear on top of his library -- Maya does not -- and casts it from there",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Elven Chorus",
            "Forest",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "seat": 0,
              "zone": "library",
              "cards": [
                "Bear"
              ]
            },
            {
              "seat": 1,
              "of": 0,
              "zone": "library",
              "cards": []
            }
          ]
        },
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Bear"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Elven Chorus",
            "Forest",
            "Wastes",
            "Bear"
          ]
        },
        {
          "seat": 0,
          "zone": "library",
          "count": 19
        }
      ]
    },
    {
      "name": "A land and an instant on top: neither played nor cast from there",
      "library": [
        "Forest",
        "Smoke Tidings"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Elven Chorus",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "play-land",
                "card": "Forest"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "library",
          "cards": [
            "Forest"
          ]
        }
      ]
    },
    {
      "name": "His Bear taps for {U}, and Tidings is cast with it; Maya's Ogre has no such ability",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Elven Chorus",
            "Bear"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Smoke Tidings"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Bear"
              },
              "count": 5
            },
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Ogre",
                "seat": 1
              },
              "count": 0
            }
          ]
        },
        {
          "tap": "Bear",
          "mana": {
            "U": 1
          }
        },
        {
          "cast": "Smoke Tidings"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "tapped": "Bear"
        }
      ]
    },
    {
      "name": "Elven Chorus gone: the top card hidden again, and not cast",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Elven Chorus",
            "Forest",
            "Wastes",
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Smoke Smash"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Smoke Smash",
          "targets": [
            {
              "card": "Elven Chorus"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "cast",
            "card": "Bear"
          },
          "count": 0
        },
        {
          "seat": 0,
          "zone": "library",
          "cards": []
        }
      ]
    }
