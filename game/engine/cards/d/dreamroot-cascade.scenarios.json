{
  "schema": "CrankCardScenarios@1",
  "card": "Dreamroot Cascade",
  "scenarios": [
    {
      "name": "Two other lands: untapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
