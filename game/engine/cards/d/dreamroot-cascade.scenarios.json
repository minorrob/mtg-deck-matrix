            "card": "Dreamroot Cascade"
          },
          "count": 2,
          "mana": [
            {
              "G": 1
            },
            {
              "U": 1
            }
          ]
        }
      ]
    },
    {
      "name": "One: tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Dreamroot Cascade"
          ]
        }
      ],
      "steps": [
        {
          "play": "Dreamroot Cascade"
        }
      ],
      "expect": [
