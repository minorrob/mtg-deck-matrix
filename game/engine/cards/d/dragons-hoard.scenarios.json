      "steps": [
        {
          "tap": "Forest",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Forest",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Bear"
        },
        {
          "resolve": true
