            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Mountain",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "cast": "Dragon"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        },
        {
          "expect": [
