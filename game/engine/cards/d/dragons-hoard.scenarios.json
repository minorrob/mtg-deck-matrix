          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "No gold counter: no draw; one mana of any color",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Dragon's Hoard"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Dragon's Hoard"
              },
              "count": 0
            },
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Dragon's Hoard"
              },
              "count": 5
            }
          ]
        },
        {
          "tap": "Dragon's Hoard",
