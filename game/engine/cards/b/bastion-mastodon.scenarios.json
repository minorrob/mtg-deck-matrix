{
  "schema": "CrankCardScenarios@1",
  "card": "Bastion Mastodon",
  "scenarios": [
    {
      "name": "{W}: vigilance; it attacks and stays untapped, and loses it on the next turn",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bastion Mastodon",
            "Plains"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "activate": "Bastion Mastodon"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "keywords": {
                "card": "Bastion Mastodon",
                "has": [
                  "Vigilance"
                ]
              }
            }
          ]
        },
        {
          "attack": [
            "Bastion Mastodon"
          ]
        },
        {
          "to": {
            "turn": 1,
            "phase": "MAIN2"
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Bastion Mastodon",
              "is": false
            },
            {
              "seat": 1,
              "life": 36
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "keywords": {
            "card": "Bastion Mastodon",
            "lacks": [
              "Vigilance"
            ]
          }
        }
      ]
    },
    {
      "name": "Without it: it attacks and taps",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bastion Mastodon"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Bastion Mastodon"
          ]
        },
        {
          "to": {
            "turn": 1,
            "phase": "MAIN2"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Bastion Mastodon",
          "is": true
        },
        {
          "seat": 1,
          "life": 36
        }
      ]
    }
  ]
}
