{
  "schema": "CrankCardScenarios@1",
  "card": "Barren Moor",
  "scenarios": [
    {
      "name": "Played, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Barren Moor"
          ]
        }
      ],
      "steps": [
        {
          "play": "Barren Moor"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Barren Moor"
        }
      ]
    },
    {
      "name": "Untapped, it taps for {B}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Barren Moor"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Barren Moor"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 1
          }
        }
      ]
    },
    {
      "name": "Cycled for {B}: discarded, and a card drawn",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Swamp"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Barren Moor"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "activate": "Barren Moor"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Barren Moor"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        }
      ]
    }
  ]
}
