{
  "schema": "CrankCardScenarios@1",
  "card": "Bayou",
  "scenarios": [
    {
      "name": "{B} or {G}: two ways; it enters untapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bayou"
          ]
        }
      ],
      "steps": [
        {
          "play": "Bayou"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Bayou"
              },
              "count": 2,
              "mana": [
                {
                  "B": 1
                },
                {
                  "G": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Bayou",
          "mana": {
            "G": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 1
          }
        }
      ]
    },
    {
      "name": "A Swamp and a Forest: Crypt Ghast adds {B} when it is tapped for mana",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bayou",
            "Crypt Ghast"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Bayou",
          "mana": {
            "G": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "G": 1,
            "B": 1
          }
        }
      ]
    }
  ]
}
