      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Boros Garrison"
          ]
        },
        {
          "seat": 0,
          "controls": []
        }
      ]
    },
    {
      "name": "Not Maya's land: only Rob's are among the choices",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Plains"
          ]
        },
        {
          "seat": 1,
