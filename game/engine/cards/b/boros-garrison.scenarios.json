          "seat": 0,
          "zone": "hand",
          "cards": [
            "Boros Garrison"
          ]
        }
      ],
      "steps": [
        {
          "play": "Boros Garrison"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Boros Garrison"
          ]
        }
