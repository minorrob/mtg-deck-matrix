          "tap": "Wastes"
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate",
            "card": "Rock"
          },
          "count": 0
        }
      ]
    },
    {
      "name": "When Bludgeon Brawl leaves, the Rock is no Equipment: it falls off and the Bear is 2/2 again",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bludgeon Brawl",
            "Bear",
            "Rock",
            "Wastes",
            "Wastes",
            "Plains"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Seal of Cleansing"
          ]
        }
