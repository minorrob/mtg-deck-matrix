        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "stats": {
            "card": "Bear",
            "power": 5,
            "toughness": 2
          }
        },
        {
          "seat": 0,
          "stats": {
            "card": "Artifact Bear",
            "power": 2,
            "toughness": 2
          }
        }
      ]
    },
    {
