  "scenarios": [
    {
      "name": "The {3} Rock is an Equipment with equip {3}: equipped, Rob's Bear is 5/2; the artifact creature and Colossus Hammer are not changed",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
