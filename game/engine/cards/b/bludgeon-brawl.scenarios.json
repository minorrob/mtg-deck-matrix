      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bludgeon Brawl",
            "Rock",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Their Bear"
          ]
        }
