{
  "schema": "CrankCardScenarios@1",
  "card": "Bear Trap",
  "fixtures": {
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Sprung for {3}: Maya's Ogre takes 3 and dies, and the Trap is sacrificed",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bear Trap",
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Bear Trap",
          "targets": [
            {
              "card": "Ogre",
              "seat": 1
            }
          ]
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Bear Trap"
              ]
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Ogre"
          ]
        },
        {
          "seat": 0,
          "controls": [
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "Flash: cast with a Bear still on the stack, the Trap resolves first",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Forest",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear",
            "Bear Trap"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Bear"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Bear Trap"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "stack": 1
            },
            {
              "seat": 0,
              "controls": [
                "Forest",
                "Wastes",
                "Wastes",
                "Bear Trap"
              ]
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Forest",
            "Wastes",
            "Wastes",
            "Bear Trap",
            "Bear"
          ]
        }
      ]
    },
    {
      "name": "Tapped, it cannot be sprung",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bear Trap",
            "Wastes",
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Bear Trap",
          "targets": [
            {
              "card": "Ogre",
              "seat": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Bear Trap"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Ogre"
          ]
        }
      ]
    }
  ]
}
