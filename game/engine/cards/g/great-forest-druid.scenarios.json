{
  "schema": "CrankCardScenarios@1",
  "card": "Great Forest Druid",
  "scenarios": [
    {
      "name": "Any color, once it has been under its controller since their turn began",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Great Forest Druid"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Great Forest Druid"
              },
              "count": 5,
              "mana": [
                {
                  "W": 1
                },
                {
                  "U": 1
                },
                {
                  "B": 1
                },
                {
                  "R": 1
                },
                {
                  "G": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Great Forest Druid",
          "mana": {
            "U": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "U": 1
          }
        }
      ]
    },
    {
      "name": "Not while summoning sick",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Great Forest Druid"
          ],
          "sick": true
        }
      ],
      "expect": [
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Great Forest Druid"
          },
          "count": 0
        }
      ]
    }
  ]
}
