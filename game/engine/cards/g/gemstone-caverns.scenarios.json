            },
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Gemstone Caverns"
              },
              "count": 5,
              "mana": [
                {
                  "W": 1
                },
                {
                  "U": 1
                },
                {
                  "B": 1
                },
                {
                  "R": 1
                },
                {
                  "G": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Gemstone Caverns",
          "mana": {
            "G": 1
          }
        }
