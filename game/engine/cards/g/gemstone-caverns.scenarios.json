        "targets": [
          {
            "what": "permanent"
          }
        ],
        "effects": [
          {
            "effect": "putCounter",
            "targets": {
              "target": 0
            },
            "counter": "luck",
            "count": 1
          }
        ]
      }
    }
  },
  "scenarios": [
