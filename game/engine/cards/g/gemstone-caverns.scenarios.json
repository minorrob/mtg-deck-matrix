          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Lucky Break"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "cast": "Lucky Break",
          "targets": [
            {
              "card": "Gemstone Caverns"
            }
          ]
        },
        {
          "resolve": true
