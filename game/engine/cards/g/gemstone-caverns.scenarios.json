    {
      "name": "Played from the hand as a land: no luck counter, {C}",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Gemstone Caverns"
          ]
        }
      ],
      "steps": [
        {
          "play": "Gemstone Caverns"
        },
        {
          "tap": "Gemstone Caverns"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 1
          }
        }
      ]
