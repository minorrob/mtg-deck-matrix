      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Gemstone Caverns"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Gemstone Caverns"
              },
              "count": 1,
              "mana": [
                {
                  "C": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Gemstone Caverns"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 1
          }
        }
      ]
    },
    {
