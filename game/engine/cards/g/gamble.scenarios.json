{
  "schema": "CrankCardScenarios@1",
  "card": "Gamble",
  "fixtures": {
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "He finds the Ogre, a card of his two is discarded at random, then his library is shuffled",
      "library": [
        "Ogre"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mountain"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Gamble",
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Mountain"
        },
        {
          "cast": "Gamble"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Ogre"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "library",
          "count": 19
        },
        {
          "event": "GameEventShuffle",
          "where": {
            "player": {
              "playerId": 0,
              "name": "Rob"
            }
          }
        }
      ]
    },
    {
      "name": "His hand was empty: the card he found is the one discarded",
      "library": [
        "Ogre"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mountain"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Gamble"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Mountain"
        },
        {
          "cast": "Gamble"
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Ogre"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 0
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Gamble",
            "Ogre"
          ]
        }
      ]
    }
  ]
}
