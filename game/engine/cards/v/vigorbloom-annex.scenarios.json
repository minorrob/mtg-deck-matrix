{
  "schema": "CrankCardScenarios@1",
  "card": "Vigorbloom Annex",
  "scenarios": [
    {
      "name": "No planeswalker: it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Vigorbloom Annex"
          ]
        }
      ],
      "steps": [
        {
          "play": "Vigorbloom Annex"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Vigorbloom Annex",
          "is": true
        }
      ]
    },
    {
      "name": "With Elspeth: untapped, and it taps for {G} or {W}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Elspeth, Sun's Champion"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Vigorbloom Annex"
          ]
        }
      ],
      "steps": [
        {
          "play": "Vigorbloom Annex"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Vigorbloom Annex",
          "is": false
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Vigorbloom Annex"
          },
          "count": 2,
          "mana": [
            {
              "G": 1
            },
            {
              "W": 1
            }
          ]
        }
      ]
    },
    {
      "name": "A planeswalker of Maya's does not count: it enters tapped",
      "setup": [
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Elspeth, Sun's Champion"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Vigorbloom Annex"
          ]
        }
      ],
      "steps": [
        {
          "play": "Vigorbloom Annex"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Vigorbloom Annex",
          "is": true
        }
      ]
    }
  ]
}
