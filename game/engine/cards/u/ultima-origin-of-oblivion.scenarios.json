{
  "schema": "CrankCardScenarios@1",
  "card": "Ultima, Origin of Oblivion",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "A blight counter on Maya's Forest: no land type, no {G}, but {T}: Add {C} -- still so on her turn",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ultima, Origin of Oblivion"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Ultima, Origin of Oblivion"
          ]
        },
        {
          "choose": [
            "Forest"
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 1,
              "counters": {
                "card": "Forest",
                "counter": "blight",
                "count": 1
              }
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Forest"
              },
              "count": 1,
              "mana": [
                {
                  "C": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Forest",
          "seat": 1
        }
      ],
      "expect": [
        {
          "seat": 1,
          "pool": {
            "C": 1,
            "G": 0
          }
        }
      ]
    },
    {
      "name": "Rob taps a land for {C}: an additional {C}; for {G}: none",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ultima, Origin of Oblivion",
            "Wastes",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "seat": 0,
              "pool": {
                "C": 2
              }
            }
          ]
        },
        {
          "tap": "Forest"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 2,
            "G": 1
          }
        }
      ]
    },
    {
      "name": "His own Forest blighted: it taps for {C}, and Ultima adds another",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ultima, Origin of Oblivion",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Ultima, Origin of Oblivion"
          ]
        },
        {
          "choose": [
            "Forest"
          ]
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 1,
            "phase": "MAIN2"
          }
        },
        {
          "tap": "Forest"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 2,
            "G": 0
          }
        }
      ]
    },
    {
      "name": "The blight counter removed: a Forest again, for good -- it taps for {G}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ultima, Origin of Oblivion",
            "Vampire Hexmage"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Ultima, Origin of Oblivion"
          ]
        },
        {
          "choose": [
            "Forest"
          ]
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 1,
            "phase": "MAIN2"
          }
        },
        {
          "activate": "Vampire Hexmage",
          "targets": [
            {
              "card": "Forest",
              "seat": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "tap": "Forest",
          "seat": 1
        }
      ],
      "expect": [
        {
          "seat": 1,
          "pool": {
            "G": 1,
            "C": 0
          }
        },
        {
          "seat": 1,
          "counters": {
            "card": "Forest",
            "counter": "blight",
            "count": 0
          }
        }
      ]
    }
  ]
}
