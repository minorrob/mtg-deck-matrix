            "card": "Troll"
          },
          "count": 0
        }
      ]
    },
    {
      "name": "The Troll on top without paying for it; then a Forest from the top, his land for the turn",
      "library": [
        "Troll",
        "Forest"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "One with the Multiverse"
          ]
        }
      ],
      "steps": [
