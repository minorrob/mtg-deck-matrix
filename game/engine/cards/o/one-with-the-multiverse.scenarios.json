    {
      "name": "The Ogre from his hand without paying for it -- then the Troll on top costs its mana, and he has none",
      "library": [
        "Troll"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "One with the Multiverse"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "cast": "Ogre"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "library",
              "cards": [
                "Troll"
              ]
            }
          ]
        }
      ],
      "expect": [
