        {
          "play": "Forest"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "One with the Multiverse",
            "Troll",
            "Forest"
          ]
        },
        {
          "seat": 0,
          "life": 40
        }
      ]
    },
    {
      "name": "Paid for instead, the free cast is kept: the Bear for his Forest and Wastes, then the Ogre free",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "One with the Multiverse",
            "Forest",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear",
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Bear"
              },
              "count": 2
            }
          ]
        },
        {
          "cast": "Bear"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Ogre"
              },
              "count": 1
            }
          ]
        },
        {
          "cast": "Ogre"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "One with the Multiverse",
            "Forest",
            "Wastes",
            "Bear",
            "Ogre"
          ]
        }
      ]
    },
