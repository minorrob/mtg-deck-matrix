  "scenarios": [
    {
      "name": "Rob finds his Blade, an Equipment, or his Shroud, an Aura -- not the Seal or the Relic -- and reveals it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Plains",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Open the Armory"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Open the Armory"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Blade",
                  "Shroud"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Blade"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Blade"
          ]
        },
        {
          "event": "GameEventCardRevealed"
        },
        {
          "event": "GameEventShuffle"
        }
      ],
      "library": [
        "Seal",
        "Relic",
        "Blade",
        "Shroud"
      ]
    },
    {
