{
  "schema": "CrankCardScenarios@1",
  "card": "Obscura Storefront",
  "scenarios": [
    {
      "name": "It enters and is sacrificed; when he does, a basic Island onto the battlefield tapped, and 1 life",
      "library": [
        "Mountain",
        "Island"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Obscura Storefront"
          ]
        }
      ],
      "steps": [
        {
          "play": "Obscura Storefront"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Obscura Storefront"
              ]
            },
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Island"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Island"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island"
          ]
        },
        {
          "seat": 0,
          "tapped": "Island",
          "is": true
        },
        {
          "seat": 0,
          "life": 41
        },
        {
          "stack": 0
        }
      ]
    }
  ]
}
