          "zone": "exile",
          "cards": [
            "Sol Ring"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Quintorius, Loremaster",
            "Spirit"
          ]
        },
        {
          "stack": 0
        }
      ]
    },
    {
