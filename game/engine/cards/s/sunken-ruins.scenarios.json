{
  "schema": "CrankCardScenarios@1",
  "card": "Sunken Ruins",
  "scenarios": [
    {
      "name": "{U} from a Island filtered into {B}{B}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Sunken Ruins",
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Sunken Ruins",
          "mana": {
            "B": 2
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "B": 2
          }
        }
      ]
    },
    {
      "name": "or into {U}{B}; alone, it adds {C}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Sunken Ruins",
            "Swamp",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp"
        },
        {
          "tap": "Sunken Ruins",
          "mana": {
            "U": 1,
            "B": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "U": 1,
            "B": 1
          }
        }
      ]
    }
  ]
}
