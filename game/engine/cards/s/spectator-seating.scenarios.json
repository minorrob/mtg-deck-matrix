{
  "schema": "CrankCardScenarios@1",
  "card": "Spectator Seating",
  "scenarios": [
    {
      "name": "One opponent: tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Spectator Seating"
          ]
        }
      ],
      "steps": [
        {
          "play": "Spectator Seating"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Spectator Seating"
        }
      ]
    },
    {
      "name": "Two opponents: untapped, either color",
      "seats": 3,
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Spectator Seating"
          ]
        }
      ],
      "steps": [
        {
          "play": "Spectator Seating"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Spectator Seating",
          "is": false
        },
        {
          "offers": {
            "kind": "activate-mana",
            "card": "Spectator Seating"
          },
          "count": 2,
          "mana": [
            {
              "R": 1
            },
            {
              "W": 1
            }
          ]
        }
      ]
    }
  ]
}
