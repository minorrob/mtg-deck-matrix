{
  "schema": "CrankCardScenarios@1",
  "card": "Sphinx of the Second Sun",
  "scenarios": [
    {
      "name": "At the beginning of its postcombat main phase: an additional beginning phase -- untap, upkeep, draw -- then the end step",
      "at": {
        "turn": 3,
        "phase": "MAIN1"
      },
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Sphinx of the Second Sun",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "seat": 0,
              "zone": "hand",
              "count": 1
            }
          ]
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN2"
          }
        },
        {
          "resolve": true
        },
        {
          "to": {
            "turn": 3,
            "phase": "END_OF_TURN"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "tapped": "Wastes",
          "is": false
        }
      ]
    }
  ]
}
