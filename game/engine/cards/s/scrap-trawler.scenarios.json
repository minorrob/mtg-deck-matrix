{
  "schema": "CrankCardScenarios@1",
  "card": "Scrap Trawler",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}",
      "colors": []
    },
    "Idol": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{2}",
      "colors": []
    }
  },
  "scenarios": [
    {
      "name": "Scrap Trawler dies: of its owner's artifact cards, one of lesser mana value (the Idol, 2) returns",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Scrap Trawler",
            "Swamp",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Overkill"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Idol"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "cast": "Overkill",
          "targets": [
            {
              "card": "Scrap Trawler"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "settle": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Idol"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Overkill",
            "Scrap Trawler"
          ]
        }
      ]
    },
    {
      "name": "Another artifact sacrificed (the Idol, 2): the Rock (1) returns, not the Trawler's equal or greater",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Scrap Trawler",
            "Idol",
            "Altar of Dementia"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Rock",
            "Haywire Mite"
          ]
        }
      ],
      "steps": [
        {
          "activate": "Altar of Dementia",
          "sacrifice": "Scrap Trawler",
          "targets": [
            {
              "player": 1
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "settle": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Rock"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        }
      ]
    }
  ]
}
