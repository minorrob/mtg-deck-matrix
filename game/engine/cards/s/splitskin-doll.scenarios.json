{
  "schema": "CrankCardScenarios@1",
  "card": "Splitskin Doll",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    }
  },
  "scenarios": [
    {
      "name": "Rob controls a Bear (power 2): he draws and keeps it",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Bear",
            "Plains",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Splitskin Doll"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Splitskin Doll"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": []
        }
      ]
    },
    {
      "name": "Only an Ogre (power 3) -- the Doll itself is not \"another\": he draws, then discards",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Ogre",
            "Plains",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Splitskin Doll",
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Plains",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "cast": "Splitskin Doll"
        },
        {
          "resolve": true
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0
              }
            }
          ]
        },
        {
          "choose": [
            "Ogre"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Ogre"
          ]
        }
      ]
    }
  ]
}
