{
  "schema": "CrankCardScenarios@1",
  "card": "Scavenger Grounds",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{2}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    },
    "Dune": {
      "types": [
        "Land"
      ],
      "subtypes": [
        "Desert"
      ],
      "manaCost": null,
      "colors": []
    }
  },
  "scenarios": [
    {
      "name": "Sacrificing itself, the Desert: every graveyard exiled, itself among them",
      "seats": 3,
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Scavenger Grounds",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Ogre"
          ]
        },
        {
          "seat": 2,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Scavenger Grounds"
              },
              "count": 1,
              "costs": [
                [
                  "Scavenger Grounds"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Scavenger Grounds",
          "sacrifice": "Scavenger Grounds"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "count": 0
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "count": 0
        },
        {
          "seat": 2,
          "zone": "graveyard",
          "count": 0
        },
        {
          "seat": 0,
          "zone": "exile",
          "cards": [
            "Bear",
            "Scavenger Grounds"
          ]
        },
        {
          "seat": 1,
          "zone": "exile",
          "cards": [
            "Ogre"
          ]
        }
      ]
    },
    {
      "name": "Or another Desert, which Rob chooses",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Scavenger Grounds",
            "Dune",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Scavenger Grounds"
              },
              "count": 2,
              "costs": [
                [
                  "Scavenger Grounds"
                ],
                [
                  "Dune"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Scavenger Grounds",
          "sacrifice": "Dune"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "exile",
          "cards": [
            "Dune"
          ]
        },
        {
          "seat": 1,
          "zone": "exile",
          "cards": [
            "Ogre"
          ]
        },
        {
          "seat": 0,
          "tapped": "Scavenger Grounds"
        }
      ]
    }
  ]
}
