{
  "schema": "CrankCardScenarios@1",
  "card": "Spire of Industry",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}"
    }
  },
  "scenarios": [
    {
      "name": "No artifact: {C} only",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Spire of Industry"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Spire of Industry"
              },
              "count": 1
            }
          ]
        }
      ],
      "expect": []
    },
    {
      "name": "With an artifact: any color, for 1 life",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Spire of Industry",
            "Rock"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Spire of Industry"
              },
              "count": 6
            }
          ]
        },
        {
          "tap": "Spire of Industry",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        },
        {
          "seat": 0,
          "life": 39
        }
      ]
    }
  ]
}
