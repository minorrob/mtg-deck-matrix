{
  "schema": "CrankCardScenarios@1",
  "card": "Spectacle Summit",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Played, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Spectacle Summit"
          ]
        }
      ],
      "steps": [
        {
          "play": "Spectacle Summit"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Spectacle Summit"
        }
      ]
    },
    {
      "name": "{T}: {U}, or {R}",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Spectacle Summit"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate-mana",
                "card": "Spectacle Summit"
              },
              "count": 2,
              "mana": [
                {
                  "U": 1
                },
                {
                  "R": 1
                }
              ]
            }
          ]
        },
        {
          "tap": "Spectacle Summit",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1,
            "U": 0
          }
        }
      ]
    },
    {
      "name": "{2}{U}{R}, {T}: surveil 1 -- the top card to the graveyard",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Spectacle Summit",
            "Island",
            "Mountain",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Mountain",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Spectacle Summit",
          "ability": "a2"
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Bear"
                ]
              }
            }
          ]
        },
        {
          "answer": [
            0
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 0,
          "tapped": "Spectacle Summit"
        }
      ]
    },
    {
      "name": "Surveil 1, kept on top: the next draw is that card",
      "library": [
        "Bear"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Spectacle Summit",
            "Island",
            "Mountain",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Mountain",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Spectacle Summit",
          "ability": "a2"
        },
        {
          "resolve": true
        },
        {
          "answer": []
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": []
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear"
          ]
        }
      ]
    }
  ]
}
