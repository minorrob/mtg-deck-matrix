{
  "schema": "CrankCardScenarios@1",
  "card": "Spirebluff Canal",
  "scenarios": [
    {
      "name": "With two other lands, it enters untapped, and taps for either color",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Mountain"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Spirebluff Canal"
          ]
        }
      ],
      "steps": [
        {
          "play": "Spirebluff Canal"
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Spirebluff Canal",
              "is": false
            }
          ]
        },
        {
          "tap": "Spirebluff Canal",
          "mana": {
            "R": 1
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "R": 1
          }
        }
      ]
    },
    {
      "name": "With three, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Island",
            "Mountain",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Spirebluff Canal"
          ]
        }
      ],
      "steps": [
        {
          "play": "Spirebluff Canal"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Spirebluff Canal"
        }
      ]
    }
  ]
}
