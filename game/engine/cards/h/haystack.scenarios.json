{
  "schema": "CrankCardScenarios@1",
  "card": "Haystack",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "His Bear phases out, and back in as his next turn begins",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Haystack",
            "Bear",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Haystack"
              },
              "count": 0
            }
          ]
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Haystack"
              },
              "count": 1,
              "targets": [
                [
                  "Bear"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Haystack",
          "targets": [
            {
              "card": "Bear",
              "seat": 0
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "battlefield",
              "cards": [
                "Haystack",
                "Wastes",
                "Wastes"
              ]
            }
          ]
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "battlefield",
              "cards": [
                "Haystack",
                "Wastes",
                "Wastes"
              ]
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Haystack",
            "Bear",
            "Wastes",
            "Wastes"
          ]
        }
      ]
    }
  ]
}
