{
  "schema": "CrankCardScenarios@1",
  "card": "Hedron Archive",
  "scenarios": [
    {
      "name": "{T}: two colorless",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Hedron Archive"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Hedron Archive"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "pool": {
            "C": 2
          }
        }
      ]
    },
    {
      "name": "{2}, {T}, sacrificed: two cards",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Hedron Archive",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Hedron Archive"
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Hedron Archive"
              ]
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "controls": [
            "Wastes",
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "Tapped already, or without {2}: no draw offered",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Hedron Archive",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Hedron Archive"
              },
              "count": 0
            }
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 0
        }
      ]
    }
  ]
}
