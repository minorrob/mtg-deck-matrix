{
  "schema": "CrankCardScenarios@1",
  "card": "Haven of the Spirit Dragon",
  "fixtures": {
    "Wyrm": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Dragon"
      ],
      "manaCost": "{1}{R}",
      "colors": [
        "R"
      ],
      "power": 2,
      "toughness": 2
    },
    "Ogre": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Ogre"
      ],
      "manaCost": "{1}{R}",
      "colors": [
        "R"
      ],
      "power": 3,
      "toughness": 3
    }
  },
  "scenarios": [
    {
      "name": "Its red casts the Dragon, not the Ogre",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Haven of the Spirit Dragon",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wyrm",
            "Ogre"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Haven of the Spirit Dragon",
          "mana": {
            "R": 1
          }
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Wyrm"
              },
              "count": 1
            },
            {
              "offers": {
                "kind": "cast",
                "card": "Ogre"
              },
              "count": 0
            }
          ]
        },
        {
          "cast": "Wyrm"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Haven of the Spirit Dragon",
            "Wastes",
            "Wyrm"
          ]
        }
      ]
    },
    {
      "name": "Sacrificed: the Dragon back from his graveyard",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Haven of the Spirit Dragon",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Wyrm"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Haven of the Spirit Dragon",
          "targets": [
            {
              "card": "Wyrm"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Wyrm"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Haven of the Spirit Dragon"
          ]
        }
      ]
    }
  ]
}
