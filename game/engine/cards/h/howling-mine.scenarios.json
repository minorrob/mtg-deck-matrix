{
  "schema": "CrankCardScenarios@1",
  "card": "Howling Mine",
  "scenarios": [
    {
      "name": "Untapped: each player's draw step, that player draws one more -- none for Rob on turn 1, who went first in a two-player game and has no draw step then (CR 103.8a)",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Howling Mine"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "UPKEEP",
            "settle": true
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "hand",
              "count": 0
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1",
            "settle": true
          }
        }
      ],
      "expect": [
        {
          "seat": 1,
          "zone": "hand",
          "count": 2
        },
        {
          "seat": 0,
          "zone": "hand",
          "count": 2
        }
      ]
    },
    {
      "name": "Tapped, it does nothing",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Howling Mine"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 1,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": []
    }
  ]
}
