          "cards": [
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "expect": [
            {
              "seat": 0,
              "stats": {
                "card": "Bear",
                "power": 2,
                "toughness": 2
              }
            }
          ]
        },
        {
          "attack": [
            "Bear"
