        {
          "to": {
            "turn": 1,
            "phase": "COMBAT_DAMAGE"
          }
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Forest"
          ]
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Forest",
              "is": true
            },
            {
              "stack": 0
            }
          ]
