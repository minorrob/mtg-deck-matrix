    {
      "name": "A land that enters in Rob's combat (Kodama of the West Tree's fetch) is not in his main phase: no trigger, no extra combat",
      "library": [
        "Forest"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Moraug, Fury of Akoum",
            "Kodama of the West Tree",
            "Bear",
            "Trailblazer's Boots",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Trailblazer's Boots",
          "targets": [
            {
              "card": "Bear"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "attack": [
            "Bear"
          ]
