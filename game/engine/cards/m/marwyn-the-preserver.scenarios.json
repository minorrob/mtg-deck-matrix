{
  "schema": "CrankCardScenarios@1",
  "card": "Marwyn, the Preserver",
  "fixtures": {
    "Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "Rob's lands have hexproof; Maya's do not",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Marwyn, the Preserver",
            "Forest"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Forest"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "keywords": {
            "card": "Forest",
            "has": [
              "Hexproof"
            ]
          }
        },
        {
          "seat": 1,
          "keywords": {
            "card": "Forest",
            "lacks": [
              "Hexproof"
            ]
          }
        },
        {
          "seat": 0,
          "keywords": {
            "card": "Marwyn, the Preserver",
            "lacks": [
              "Hexproof"
            ]
          }
        }
      ]
    },
    {
      "name": "{2}: the Forest in Rob's graveyard returns to his hand, not the Bear",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Marwyn, the Preserver",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Forest",
            "Bear"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": [
            "Island"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "activate",
                "card": "Marwyn, the Preserver"
              },
              "count": 1,
              "targets": [
                [
                  "Forest"
                ]
              ]
            }
          ]
        },
        {
          "activate": "Marwyn, the Preserver",
          "targets": [
            {
              "card": "Forest"
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Forest"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        }
      ]
    }
  ]
}
