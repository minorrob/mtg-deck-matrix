          "cards": [
            "Island",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Bear",
            "Bear"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Island"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Midnight Clock",
          "ability": "a1"
