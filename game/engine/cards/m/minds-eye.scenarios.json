      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mind's Eye",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "to": {
            "turn": 2,
            "phase": "DRAW"
          }
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Don't pay"
