{
  "schema": "CrankCardScenarios@1",
  "card": "Mesmeric Orb",
  "scenarios": [
    {
      "name": "Each permanent untapped in its controller's untap step mills that player a card",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mesmeric Orb",
            "Forest",
            "Island"
          ]
        },
        {
          "seat": 1,
          "zone": "battlefield",
          "cards": [
            "Swamp"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Island"
        },
        {
          "to": {
            "turn": 2,
            "phase": "MAIN1"
          }
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": []
            }
          ]
        },
        {
          "to": {
            "turn": 3,
            "phase": "MAIN1"
          }
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 1,
          "zone": "graveyard",
          "cards": []
        }
      ]
    },
    {
      "name": "An untap effect (Deserted Temple) mills the land's controller",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mesmeric Orb",
            "Deserted Temple",
            "Wastes",
            "Forest"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "activate": "Deserted Temple",
          "ability": "a1",
          "targets": [
            {
              "card": "Forest"
            }
          ]
        },
        {
          "choose": [
            "{C}"
          ]
        },
        {
          "resolve": true
        },
        {
          "settle": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "tapped": "Forest",
          "is": false
        }
      ]
    }
  ]
}
