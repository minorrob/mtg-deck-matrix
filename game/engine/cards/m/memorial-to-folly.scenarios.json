    {
      "name": "Sacrificed: a creature card back to hand",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Memorial to Folly",
            "Swamp",
            "Wastes",
            "Wastes"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Moss Bear"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Swamp",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 0
          }
        },
        {
          "tap": "Wastes",
          "source": {
            "zone": "battlefield",
            "index": 1
          }
        },
        {
          "activate": "Memorial to Folly",
          "targets": [
            {
              "card": "Moss Bear"
            }
