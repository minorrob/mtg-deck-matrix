{
  "schema": "CrankCardScenarios@1",
  "card": "Meanders Guide",
  "fixtures": {
    "Merfolk": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Merfolk"
      ],
      "manaCost": "{U}",
      "colors": [
        "U"
      ],
      "power": 1,
      "toughness": 1
    },
    "Old Bear": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Bear"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    },
    "Big One": {
      "types": [
        "Creature"
      ],
      "subtypes": [
        "Beast"
      ],
      "manaCost": "{3}{G}",
      "colors": [
        "G"
      ],
      "power": 4,
      "toughness": 4
    }
  },
  "scenarios": [
    {
      "name": "It attacks; Rob taps his other Merfolk, and when he does, the Bear returns from his graveyard -- never the four-drop",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Meanders Guide",
            "Merfolk"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Old Bear",
            "Big One"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Meanders Guide"
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Tap Merfolk",
                  "Don't pay"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Tap Merfolk"
          ]
        },
        {
          "expect": [
            {
              "seat": 0,
              "tapped": "Merfolk"
            }
          ]
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Old Bear"
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "controls": [
            "Meanders Guide",
            "Merfolk",
            "Old Bear"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Big One"
          ]
        }
      ]
    },
    {
      "name": "Rob declines: nothing tapped, and no \"when you do\"",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Meanders Guide",
            "Merfolk"
          ]
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Old Bear"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Meanders Guide"
          ]
        },
        {
          "resolve": true
        },
        {
          "choose": [
            "Don't pay"
          ]
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Merfolk",
          "is": false
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Old Bear"
          ]
        },
        {
          "stack": 0
        }
      ]
    },
    {
      "name": "Its own tap pays nothing: with no other untapped Merfolk, there is only not paying",
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Meanders Guide",
            "Old Bear"
          ]
        }
      ],
      "steps": [
        {
          "attack": [
            "Meanders Guide"
          ]
        },
        {
          "resolve": true
        },
        {
          "expect": [
            {
              "asks": {
                "seat": 0,
                "options": [
                  "Don't pay"
                ]
              }
            }
          ]
        },
        {
          "choose": [
            "Don't pay"
          ]
        }
      ],
      "expect": [
        {
          "stack": 0
        }
      ]
    }
