{
  "schema": "CrankCardScenarios@1",
  "card": "Mystic Forge",
  "fixtures": {
    "Rock": {
      "types": [
        "Artifact"
      ],
      "manaCost": "{1}"
    },
    "Bear": {
      "types": [
        "Creature"
      ],
      "manaCost": "{1}{G}",
      "colors": [
        "G"
      ],
      "power": 2,
      "toughness": 2
    }
  },
  "scenarios": [
    {
      "name": "An artifact cast from the top of the library",
      "library": [
        "Rock"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mystic Forge",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "cast": "Rock"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mystic Forge",
            "Rock",
            "Wastes"
          ]
        }
      ]
    },
    {
      "name": "Not a green creature; {T}, 1 life: the top card exiled",
      "library": [
        "Bear",
        "Rock"
      ],
      "setup": [
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Mystic Forge",
            "Forest",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Forest"
        },
        {
          "tap": "Wastes"
        },
        {
          "expect": [
            {
              "offers": {
                "kind": "cast",
                "card": "Bear"
              },
              "count": 0
            }
          ]
        },
        {
          "activate": "Mystic Forge"
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "exile",
          "cards": [
            "Bear"
          ]
        },
        {
          "seat": 0,
          "life": 39
        }
      ]
    }
  ]
}
