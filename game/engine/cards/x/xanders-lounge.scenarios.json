{
  "schema": "CrankCardScenarios@1",
  "card": "Xander's Lounge",
  "scenarios": [
    {
      "name": "Cycling: 3 and the card itself, for a card",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Xander's Lounge"
          ]
        },
        {
          "seat": 0,
          "zone": "battlefield",
          "cards": [
            "Wastes",
            "Wastes",
            "Wastes"
          ]
        }
      ],
      "steps": [
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "tap": "Wastes"
        },
        {
          "activate": "Xander's Lounge"
        },
        {
          "expect": [
            {
              "seat": 0,
              "zone": "graveyard",
              "cards": [
                "Xander's Lounge"
              ]
            },
            {
              "stack": 1
            }
          ]
        },
        {
          "resolve": true
        }
      ],
      "expect": [
        {
          "seat": 0,
          "zone": "hand",
          "count": 1
        },
        {
          "seat": 0,
          "zone": "graveyard",
          "cards": [
            "Xander's Lounge"
          ]
        }
      ]
    },
    {
      "name": "Played, it enters tapped",
      "setup": [
        {
          "seat": 0,
          "zone": "hand",
          "cards": [
            "Xander's Lounge"
          ]
        }
      ],
      "steps": [
        {
          "play": "Xander's Lounge"
        }
      ],
      "expect": [
        {
          "seat": 0,
          "tapped": "Xander's Lounge"
        }
      ]
    }
  ]
}
