  {"id": "derived-from-the-cost-when-no-identity-is-given", "rule": "identity", "expect": ["identity"], "swap": [["Thornbite Staff", "Kitchen Finks"]], "strip": ["ci"]},
  {"id": "derived-from-a-basic-land-type", "rule": "identity", "expect": ["identity"], "swap": [["Thornbite Staff", "Dryad Arbor"]], "strip": ["ci"]},
  {"id": "derived-identity-inside-the-colors", "rule": "identity", "expect": [], "strip": ["ci"], "note": "Krenko's hundred derives red or colorless for every card"},
  {"id": "colorless-is-inside-every-identity", "rule": "identity", "expect": [], "swap": [["Thornbite Staff", "Command Tower"]]},
  {"id": "partners-widen-the-identity", "rule": "identity", "expect": [], "commanders": ["Rograkh, Son of Rohgahh", "Silas Renn, Seeker Adept"], "remove": ["Thornbite Staff", "Goblin Bombardment", "Skirk Prospector"], "add": ["Counterspell"]},
  {"id": "nothing-to-check", "rule": "identity", "expect": [], "swap": [["Thornbite Staff", "Counterspell"]], "strip": "all", "note": "bare names: identity is not checked and the note says so"},
  {"id": "two-copies", "rule": "singleton", "expect": ["singleton"], "setQuantity": [["Lightning Bolt", 2]], "remove": ["Thornbite Staff"], "expectCard": "Lightning Bolt"},
  {"id": "two-rows-of-one-card", "rule": "singleton", "expect": ["singleton"], "add": ["Lightning Bolt"], "remove": ["Thornbite Staff"]},
  {"id": "the-commander-again-in-the-list", "rule": "singleton", "expect": ["singleton"], "commanders": ["Krenko, Mob Boss"], "add": ["Krenko, Mob Boss"], "remove": ["Thornbite Staff"]},
  {"id": "basics-repeat", "rule": "singleton", "expect": [], "note": "the base carries 33 Mountains"},
