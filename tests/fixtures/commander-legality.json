  {"id": "not-a-legendary-creature", "rule": "eligible", "expect": ["eligible"], "commanders": ["Goblin Guide"], "remove": ["Thornbite Staff"], "expectCard": "Goblin Guide"},
  {"id": "vehicle-that-says-so", "rule": "eligible", "expect": [], "commanders": [{"name": "Shorikai, Genesis Engine", "type": "Legendary Artifact — Vehicle", "ci": ["U", "W"], "text": "{1}, {T}: Draw two cards, then discard a card. Create a 1/1 colorless Pilot creature token with \"This token crews Vehicles as though its power were 2 greater.\"\nCrew 8\nShorikai, Genesis Engine can be your commander."}], "cards": [["Island", 50], ["Plains", 49]], "note": "the engine oracle drops the line that says so, so the row carries the catalog's text"},
  {"id": "background-alone", "rule": "eligible", "expect": ["eligible"], "commanders": ["Raised by Giants"], "cards": [["Forest", 99]]},
  {"id": "background-pair", "rule": "pair", "expect": [], "commanders": ["Wilson, Refined Grizzly", "Raised by Giants"], "cards": [["Forest", 98]]},
  {"id": "background-with-the-wrong-commander", "rule": "pair", "expect": ["pair"], "commanders": ["Raised by Giants", "Krenko, Mob Boss"], "cards": [["Forest", 49], ["Mountain", 49]]},
  {"id": "partners", "rule": "pair", "expect": [], "commanders": ["Rograkh, Son of Rohgahh", "Silas Renn, Seeker Adept"], "remove": ["Thornbite Staff", "Goblin Bombardment"]},
  {"id": "partner-with-each-other", "rule": "pair", "expect": [], "commanders": ["Pir, Imaginative Rascal", "Toothy, Imaginary Friend"], "cards": [["Forest", 49], ["Island", 49]]},
  {"id": "partner-with-someone-else", "rule": "pair", "expect": ["pair"], "commanders": ["Pir, Imaginative Rascal", "Rograkh, Son of Rohgahh"], "cards": [["Forest", 49], ["Mountain", 49]]},
  {"id": "partner-and-a-non-partner", "rule": "pair", "expect": ["pair"], "commanders": ["Tymna the Weaver", "Krenko, Mob Boss"], "cards": [["Plains", 33], ["Swamp", 33], ["Mountain", 32]]},
  {"id": "doctor-and-companion", "rule": "pair", "expect": [], "commanders": ["The Tenth Doctor", "Donna Noble"], "cards": [["Island", 49], ["Mountain", 49]]},
  {"id": "companion-without-a-doctor", "rule": "pair", "expect": ["pair"], "commanders": ["Donna Noble", "Krenko, Mob Boss"], "cards": [["Mountain", 98]]},
  {"id": "banned-by-name", "rule": "banned", "expect": ["banned"], "swap": [["Thornbite Staff", {"name": "Mana Crypt"}]], "expectCard": "Mana Crypt"},
  {"id": "banned-by-its-front-face", "rule": "banned", "expect": ["banned"], "swap": [["Thornbite Staff", {"name": "Erayo, Soratami Ascendant"}]]},
  {"id": "banned-by-its-own-legality", "rule": "banned", "expect": ["banned"], "swap": [["Thornbite Staff", {"name": "A Card The List Missed", "legalities": {"commander": "banned"}, "colorIdentity": []}]], "banned": false},
  {"id": "banned-list-not-supplied", "rule": "banned", "expect": [], "swap": [["Thornbite Staff", {"name": "Mana Crypt"}]], "banned": false, "note": "without a list a bare name cannot be refused; the note says so"},
  {"id": "not-legal-in-commander", "rule": "not-legal", "expect": ["not-legal"], "swap": [["Thornbite Staff", {"name": "Chaos Confetti", "legalities": {"commander": "not_legal"}, "colorIdentity": []}]], "expectCard": "Chaos Confetti"},
  {"id": "legal-by-its-own-legality", "rule": "not-legal", "expect": [], "swap": [["Thornbite Staff", {"name": "A Verified Red Card", "legalities": {"commander": "legal"}, "colorIdentity": ["R"]}]]},
