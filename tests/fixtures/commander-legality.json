{
 "about": "Cases for commander-legality.js (Linear ROB-104): each rule with a failing and a passing case. The base hundred is D6 Krenko Goblins from data/live-state.json, the commander among the hundred; rows are hydrated from data/engine/oracle.json by name. `expect` is the exact set of problem codes; [] means legal.",
 "ops": "commanders (names); cards (explicit rows, else the base); remove; add; swap [[old, new]]; setQuantity [[name, n]]; strip (fields deleted from every row, or \"all\" for bare names); a row with bare: true is the name alone; strict; banned (false to pass no list)",
 "cases": [
  {"id": "krenko-as-is", "rule": "all", "expect": []},
  {"id": "ninety-nine", "rule": "size", "expect": ["size"], "remove": ["Thornbite Staff"], "expectCard": "Deck list"},
  {"id": "hundred-and-one", "rule": "size", "expect": ["size"], "add": ["Goblin Guide"]},
  {"id": "commanders-named-separately", "rule": "size", "expect": [], "commanders": ["Krenko, Mob Boss"], "note": "the commander lifted out of the hundred once, so the count stays a hundred"},
  {"id": "one-commander", "rule": "commander", "expect": [], "commanders": ["Krenko, Mob Boss"]},
