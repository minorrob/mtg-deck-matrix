  {"id": "seven-dwarves", "rule": "singleton", "expect": [], "commanders": ["Krenko, Mob Boss"], "cards": [["Krenko, Mob Boss", 1], ["Seven Dwarves", 7], ["Mountain", 92]]},
  {"id": "eight-dwarves", "rule": "singleton", "expect": ["singleton"], "commanders": ["Krenko, Mob Boss"], "cards": [["Krenko, Mob Boss", 1], ["Seven Dwarves", 8], ["Mountain", 91]], "expectCard": "Seven Dwarves"},
  {"id": "unverified-is-a-note", "rule": "unverified", "expect": [], "swap": [["Thornbite Staff", {"name": "Goblin Guide", "bare": true}]], "note": "a bare name with no data is counted, not refused"},
  {"id": "unverified-is-refused-when-strict", "rule": "unverified", "expect": ["unverified"], "swap": [["Thornbite Staff", {"name": "Goblin Guide", "bare": true}]], "strict": true},
  {"id": "companion-is-noted", "rule": "note", "expect": [], "commanders": ["Kenrith, the Returned King"], "cards": [["Jegantha, the Wellspring", 1], ["Plains", 98]]},
  {"id": "everything-at-once", "rule": "all", "expect": ["size", "banned", "identity", "singleton"], "swap": [["Thornbite Staff", {"name": "Mana Crypt"}], ["Goblin Bombardment", "Counterspell"]], "setQuantity": [["Lightning Bolt", 2]]}
 ]
}
