{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/commander-brackets.json",
  "title": "The Commander Brackets as the app judges by them: five brackets, each rule's allowance, dated",
  "type": "object",
  "properties": {
    "schema": {"type": "string", "const": "commander-brackets@1"},
    "updatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "generator": {"type": "string", "const": "hand-maintained"},
    "count": {"type": "integer", "const": 5},
    "source": {"type": "string"},
    "rules": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"type": "object", "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "says": {"type": "string"}}, "required": ["id", "label", "says"], "additionalProperties": false}
    },
    "brackets": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "n": {"type": "integer", "minimum": 1, "maximum": 5},
          "name": {"type": "string"},
          "gameChangers": {"type": ["integer", "null"], "minimum": 0},
          "massLandDenial": {"type": "boolean"},
          "extraTurnChains": {"type": "boolean"},
          "twoCardCombos": {"type": "string", "enum": ["none", "late", "any"]},
          "tutorsLight": {"type": "boolean"},
          "says": {"type": "string"}
        },
        "required": ["n", "name", "gameChangers", "massLandDenial", "extraTurnChains", "twoCardCombos", "tutorsLight", "says"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "updatedAt", "generator", "count", "source", "rules", "brackets"],
  "additionalProperties": false
}
