{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/cards.json",
  "title": "The Card record set: every card the library, the decks, the ladders and the pop-ups name — identity, printed facts, the shown printing, one dated price, the graph's rank, and the classifier's terms",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "cards@2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "const": "tools/build-card-records.mjs"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "oracleId": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "manaCost": {
            "type": "string"
          },
          "typeLine": {
            "type": "string"
          },
          "power": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "toughness": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "oracleText": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colorIdentity": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "W",
                "U",
                "B",
                "R",
                "G"
              ]
            }
          },
          "legalities": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "rarity": {
            "type": "string"
          },
          "setName": {
            "type": "string"
          },
          "setCode": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "imageSmall": {
            "type": "string"
          },
          "tcgplayerUrl": {
            "type": "string"
          },
          "scryfallUrl": {
            "type": "string"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "priceUpdated": {
            "type": "string"
          },
          "priceFoil": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cheapestSet": {
            "type": "string"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "isCommander": {
            "type": "boolean"
          },
          "printings": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "multiplies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "extends": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "mechanics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tribes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "wants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "makes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "wantsStat": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "offersStat": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "oracleId",
          "typeLine",
          "colorIdentity",
          "rarity",
          "price",
          "priceUpdated",
          "isCommander"
        ],
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "generatedAt",
    "generator",
    "count",
    "source",
    "cards",
    "missing"
  ],
  "additionalProperties": false
}
