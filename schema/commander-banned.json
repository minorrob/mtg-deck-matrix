{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/commander-banned.json",
  "title": "The Commander banned list by oracle name, as Scryfall's banned:commander search returns it, dated by generatedAt",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "commander-banned@1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "const": "tools/commander-banned.mjs"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "generatedAt",
    "generator",
    "count",
    "source",
    "cards"
  ],
  "additionalProperties": false
}
