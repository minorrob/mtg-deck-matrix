{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/vendors.json",
  "title": "The vendor assumptions behind the buy plan: price factor over Scryfall's usd, shipping, lead time, what each is assumed to carry",
  "type": "object",
  "properties": {
    "schema": {"type": "string", "const": "vendors@1"},
    "updatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
    "generator": {"type": "string", "const": "hand-maintained"},
    "count": {"type": "integer", "minimum": 1},
    "note": {"type": "string"},
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["mail", "counter"]},
          "priceFactor": {"type": "number", "minimum": 0.5, "maximum": 3},
          "shippingFlat": {"type": "number", "minimum": 0},
          "freeOver": {"type": "number", "minimum": 0},
          "leadDays": {"type": "integer", "minimum": 0},
          "carries": {"type": "string"},
          "says": {"type": "string"}
        },
        "required": ["id", "name", "kind", "priceFactor", "shippingFlat", "freeOver", "leadDays", "carries", "says"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "updatedAt", "generator", "count", "note", "vendors"],
  "additionalProperties": false
}
