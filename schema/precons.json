{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/precons.json",
  "title": "Every Commander precon's hundred, from Wizards' published decklists via MTGJSON",
  "type": "object",
  "required": ["schema", "generatedAt", "generator", "count", "source", "decks"],
  "properties": {
    "schema": {"type": "string", "const": "precons@1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "generator": {"type": "string", "const": "tools/build-precons.mjs"},
    "count": {"type": "integer", "minimum": 100},
    "source": {"type": "string"},
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "releaseDate", "commander", "cards", "total"],
        "properties": {
          "id": {"type": "string"},
          "code": {"type": "string"},
          "name": {"type": "string"},
          "releaseDate": {"type": "string"},
          "commander": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["name", "colorIdentity"],
              "properties": {
                "name": {"type": "string"},
                "colorIdentity": {"type": "array", "items": {"type": "string", "enum": ["W", "U", "B", "R", "G"]}}
              }
            }
          },
          "cards": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}},
          "total": {"type": "integer", "const": 100},
          "notInUniverse": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
