{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minorrob.github.io/mtg-deck-matrix/schema/live-load.json",
  "title": "Rob's collection in plain form, built from the Master workbook: deck targets, what is in each box, the bench, orders, the buy list, upgrades",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "live-load@1"
    },
    "format": {
      "type": "string",
      "const": "crankmagic-live-load"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "const": "tools/build-live-load.mjs"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "workbook": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "commander": {
            "type": "string"
          },
          "definition": {},
          "cards": {}
        },
        "required": [
          "id",
          "name",
          "commander",
          "cards"
        ]
      }
    },
    "owned": {
      "type": "object",
      "properties": {
        "inDeck": {},
        "bench": {}
      },
      "required": [
        "inDeck",
        "bench"
      ]
    },
    "ordered": {},
    "buy": {},
    "upgrades": {},
    "prints": {
      "type": "object",
      "description": "W1: card name -> the prints of its owned copies, from the Master sheet's two print groups (Series, Collector #, Quantity, Foil, Artist, Value); tools/live-load.js places them, the dearest in the deck boxes",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "series": {
              "type": "string"
            },
            "collector": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "foil": {
              "type": "boolean"
            },
            "artist": {
              "type": "string"
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "quantity"
          ]
        }
      }
    }
  },
  "required": [
    "schema",
    "format",
    "version",
    "savedAt",
    "generator",
    "count",
    "decks",
    "owned"
  ]
}
