# Simulation runtime artifacts. The committed placeholders (sim/status.json,
# sim/config.json, sim/opponents.json) stay tracked; everything a run produces
# does not.
sim/requests/*
!sim/requests/.gitkeep
sim/results/*
!sim/results/.gitkeep
sim/cache/*
!sim/cache/.gitkeep
sim/sim-ledger.json

# The sweep writes one file per variant while it runs; the baked outputs live
# in data/, not here.
sim/sweep/*
!sim/sweep/.gitkeep

# Screenshots from tests/uat/journeys.mjs -- regenerated on every run.
tests/uat/shots/
tests/uat/crankmagic-failure.png

# Local implementation helpers and downloaded inspection sources.
/work/

# Rules text pulled for a rebake. Regenerable; the bake it feeds is committed.
graph/.cache/

# Local Commander engine, decks, private journals and toolchains.
game/.local/

# The app has no dependencies. Playwright is installed transiently -- by CI, and by anyone
# reproducing CI locally -- with `npm install --no-save --no-package-lock playwright`, which
# still leaves node_modules in the working tree. It is never part of a commit.
node_modules/
