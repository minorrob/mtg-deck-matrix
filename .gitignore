# Simulation runtime artefacts. The committed placeholders (sim/status.json,
# sim/config.json, sim/opponents.json) stay tracked; everything a run produces
# does not.
sim/requests/*
!sim/requests/.gitkeep
sim/results/*
!sim/results/.gitkeep
sim/cache/*
!sim/cache/.gitkeep
sim/sim-ledger.json

# The sweep writes one file per variant while it runs; the baked outputs live
# in data/, not here.
sim/sweep/*
!sim/sweep/.gitkeep
