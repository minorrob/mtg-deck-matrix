  "altCommanderCases": {
    "1o": {
      "currentCommander": "Betor, Ancestor's Voice",
      "currentScore": 80.1,
      "currentRank": 4,
      "altCommander": "Teneb, the Harvester",
      "altScore": 80.3,
      "altRank": 3,
      "candidatesMeasured": 15,
      "gamesEach": 4000,
      "altPrice": 0.98,
      "honestRead": "Holds up. Teneb is a genuine reanimator, which is what this shell already wants, and it measures a hair above Betor (+0.2 — inside noise). Betor's end-step lifegain-to-counters engine is invisible to the model, so the true gap likely favours Betor. Swap only if you prefer the play pattern, not for the number."
    },
    "3e": {
      "currentCommander": "The Gitrog Monster",
      "currentScore": 63,
      "currentRank": 7,
      "altCommander": "Hazel of the Rootbloom",
      "altScore": 67.5,
      "altRank": 3,
      "candidatesMeasured": 15,
      "gamesEach": 4000,
      "altPrice": 6.45,
      "honestRead": "Real gain, real cost. Hazel measures +4.5 over Gitrog, but the optimizer's response to her is to strip TEN lands from a 48-land lands-matter deck — she pays off tokens, not landfall. That is not a minor tweak; it converts the Golgari Land Engine into a different deck. Adopt only if you want that rebuild."
    },
    "5o": {
      "currentCommander": "Quintorius, History Chaser",
      "currentScore": 59.6,
      "currentRank": 15,
      "altCommander": "Iroas, God of Victory",
      "altScore": 72.8,
      "altRank": 1,
      "candidatesMeasured": 15,
      "gamesEach": 4000,
      "altPrice": 12.88,
      "honestRead": "Treat the +13.2 as unreliable. Iroas only beats Quintorius in the model because the engine cannot see devotion and so treats it as a permanent 7/4 body. Forced to behave as the enchantment it usually is, Iroas scores 59.6 — identical to Quintorius. This deck's 50 nonland permanents average 1.22 red/white pips, so a typical board reaches roughly 5.5 devotion against the 7 Iroas needs. It will usually not be a creature."
    }
  }
